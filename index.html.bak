<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Dot2Shape — Team Portal</title>
<style>
/* ── TOKENS ── */
:root{
  --navy:#0D1B4B;--indigo:#6366F1;--indigo-dark:#4F46E5;--purple:#8B5CF6;
  --sky:#38BDF8;--gold:#F59E0B;--green:#10B981;--red:#EF4444;--rose:#F43F5E;
  --bg:#F0F2F8;--white:#fff;--border:#E5E7EB;--muted:#6B7280;--text:#111827;
  --sidebar-w:248px;
  --radius-sm:8px;--radius-md:12px;--radius-lg:16px;--radius-xl:20px;
  --shadow-sm:0 1px 4px rgba(0,0,0,.06);--shadow-md:0 4px 16px rgba(0,0,0,.1);
  --shadow-lg:0 20px 60px rgba(0,0,0,.2);
  --transition:.15s ease;
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;background:var(--bg);color:var(--text);min-height:100vh;-webkit-font-smoothing:antialiased}

/* ── SKIP LINK (a11y) ── */
.skip-link{position:absolute;top:-40px;left:8px;background:var(--indigo);color:#fff;padding:8px 16px;border-radius:var(--radius-sm);font-size:13px;font-weight:600;z-index:9999;text-decoration:none;transition:top .15s}
.skip-link:focus{top:8px}

/* ── FOCUS RING (a11y) ── */
:focus-visible{outline:2.5px solid var(--indigo);outline-offset:2px;border-radius:4px}
button:focus:not(:focus-visible),a:focus:not(:focus-visible){outline:none}

/* ── AUTH ── */
.auth-wrap{min-height:100vh;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#0D1B4B 0%,#1e3a8a 55%,#312e81 100%);padding:20px}
.auth-card{background:#fff;border-radius:var(--radius-xl);padding:44px 48px;width:100%;max-width:420px;box-shadow:var(--shadow-lg)}
.auth-logo{display:flex;justify-content:center;margin-bottom:36px}
.auth-title{font-size:21px;font-weight:700;color:var(--navy);margin-bottom:6px;text-align:center}
.auth-sub{font-size:13px;color:var(--muted);text-align:center;margin-bottom:28px}
.auth-footer{margin-top:20px;text-align:center;font-size:12px;color:var(--muted)}
.auth-footer a{color:var(--indigo);text-decoration:none;font-weight:600}
.auth-footer a:hover{text-decoration:underline}

/* ── FORM FIELDS ── */
.field{margin-bottom:16px}
.field label{display:block;font-size:11px;font-weight:700;color:var(--navy);margin-bottom:6px;text-transform:uppercase;letter-spacing:.6px}
.field input,.field select,.field textarea{width:100%;padding:11px 14px;border:1.5px solid var(--border);border-radius:var(--radius-sm);font-size:14px;color:var(--text);outline:none;transition:border .15s,box-shadow .15s;background:#fff;font-family:inherit}
.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--indigo);box-shadow:0 0 0 3px rgba(99,102,241,.12)}
.field textarea{resize:vertical}

/* ── BUTTONS ── */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:11px 20px;border-radius:var(--radius-sm);font-size:14px;font-weight:600;cursor:pointer;border:none;transition:all var(--transition);font-family:inherit;white-space:nowrap}
.btn:disabled{opacity:.5;cursor:not-allowed}
.btn-primary{background:linear-gradient(135deg,var(--indigo),var(--indigo-dark));color:#fff;width:100%}
.btn-primary:hover:not(:disabled){opacity:.92;transform:translateY(-1px);box-shadow:0 4px 12px rgba(99,102,241,.35)}
.btn-secondary{background:var(--bg);color:var(--navy);border:1.5px solid var(--border)}
.btn-secondary:hover{border-color:var(--indigo);color:var(--indigo);background:#fff}
.btn-danger{background:#FEF2F2;color:var(--red);border:1px solid #FECACA}
.btn-danger:hover{background:#FEE2E2}
.btn-sm{padding:7px 14px;font-size:12px;border-radius:var(--radius-sm)}
.btn-icon{background:none;border:none;cursor:pointer;padding:7px;border-radius:var(--radius-sm);color:var(--muted);transition:all .12s;display:inline-flex;align-items:center;justify-content:center;min-width:32px;min-height:32px}
.btn-icon:hover{background:var(--bg);color:var(--indigo)}
.btn-icon.danger:hover{background:#FEF2F2;color:var(--red)}
.btn-icon svg{width:15px;height:15px;pointer-events:none}

/* ── ERROR / SUCCESS ── */
.err-msg{color:var(--red);font-size:12px;margin-top:-8px;margin-bottom:10px;display:none}
.err-msg.show{display:block}

/* ── LOGO MARK (reusable) ── */
.logo-mark{display:inline-block;line-height:0}

/* ── SIDEBAR ── */
#screen-app{display:flex;min-height:100vh}
.sidebar{width:var(--sidebar-w);background:var(--navy);display:flex;flex-direction:column;flex-shrink:0;position:fixed;top:0;left:0;height:100vh;z-index:100;overflow-y:auto}
.sidebar-logo{padding:22px 20px 16px;border-bottom:1px solid rgba(255,255,255,.08)}
.sidebar-logo svg{width:130px;height:auto}

/* Profile button */
.sb-profile-btn{padding:13px 18px;border-bottom:1px solid rgba(255,255,255,.08);display:flex;align-items:center;gap:10px;cursor:pointer;background:transparent;border-left:none;border-right:none;border-top:none;width:100%;text-align:left;transition:background .15s}
.sb-profile-btn:hover{background:rgba(255,255,255,.06)}
.sb-profile-btn:focus-visible{outline:2px solid rgba(255,255,255,.5);outline-offset:-2px}
.sb-avatar{width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--indigo),var(--purple));display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;color:#fff;flex-shrink:0;overflow:hidden}
.sb-avatar img{width:100%;height:100%;object-fit:cover;border-radius:50%}
.sb-user-info{flex:1;min-width:0}
.sb-user-info .name{font-size:13px;font-weight:600;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sb-user-info .email{font-size:11px;color:rgba(255,255,255,.45);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sb-edit-hint{font-size:10px;color:rgba(255,255,255,.25);flex-shrink:0;opacity:0;transition:opacity .15s}
.sb-profile-btn:hover .sb-edit-hint{opacity:1}

nav{padding:12px 10px;flex:1}
.nav-section{font-size:10px;font-weight:700;color:rgba(255,255,255,.28);letter-spacing:1.2px;text-transform:uppercase;padding:10px 10px 4px;margin-top:4px}
.nav-item{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:var(--radius-sm);cursor:pointer;color:rgba(255,255,255,.6);font-size:13px;font-weight:500;transition:all .15s;margin-bottom:2px;text-decoration:none;background:none;border:none;width:100%;font-family:inherit}
.nav-item:hover{background:rgba(255,255,255,.07);color:#fff}
.nav-item.active{background:rgba(99,102,241,.3);color:#fff}
.nav-item svg{width:18px;height:18px;flex-shrink:0}
.sidebar-footer{padding:14px 16px;border-top:1px solid rgba(255,255,255,.08)}

/* ── MAIN ── */
.main-content{margin-left:var(--sidebar-w);flex:1;min-height:100vh;overflow-y:auto}

/* ── TOPBAR ── */
.topbar{background:#fff;border-bottom:1px solid var(--border);padding:14px 28px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:50;gap:12px}
.topbar-title{font-size:17px;font-weight:700;color:var(--navy)}
.topbar-actions{display:flex;gap:8px;align-items:center;flex-shrink:0}

/* ── PAGES ── */
.page{display:none}
.page.active{display:block}
.page-body{padding:28px}

/* ── STAT CARDS (clickable KPI) ── */
.stat-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:14px;margin-bottom:28px}
.stat-card{background:#fff;border-radius:var(--radius-md);padding:20px;box-shadow:var(--shadow-sm);cursor:pointer;transition:all .18s;border:2px solid transparent;position:relative;overflow:hidden}
.stat-card::after{content:'';position:absolute;inset:0;background:transparent;transition:background .15s}
.stat-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-md);border-color:var(--indigo)}
.stat-card:hover::after{background:rgba(99,102,241,.03)}
.stat-card:focus-visible{outline:2.5px solid var(--indigo);outline-offset:2px}
.stat-card .s-icon{width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;margin-bottom:14px}
.stat-card .s-icon svg{width:18px;height:18px}
.stat-card .s-label{font-size:11px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.6px;margin-bottom:6px}
.stat-card .s-val{font-size:32px;font-weight:800;line-height:1;letter-spacing:-1px}
.stat-card .s-sub{font-size:11px;color:#9CA3AF;margin-top:5px;display:flex;align-items:center;gap:4px}
.stat-card .s-caret{font-size:10px;color:var(--indigo);margin-top:8px;font-weight:600;opacity:0;transition:opacity .15s}
.stat-card:hover .s-caret{opacity:1}
/* card colour variants */
.c-indigo .s-icon{background:#EEF2FF}.c-indigo .s-icon svg{stroke:#6366F1}.c-indigo .s-val{color:var(--indigo)}
.c-green  .s-icon{background:#F0FDF4}.c-green  .s-icon svg{stroke:#10B981}.c-green  .s-val{color:var(--green)}
.c-sky    .s-icon{background:#F0F9FF}.c-sky    .s-icon svg{stroke:#0EA5E9}.c-sky    .s-val{color:#0EA5E9}
.c-amber  .s-icon{background:#FFFBEB}.c-amber  .s-icon svg{stroke:#F59E0B}.c-amber  .s-val{color:var(--gold)}
.c-rose   .s-icon{background:#FFF1F2}.c-rose   .s-icon svg{stroke:#F43F5E}.c-rose   .s-val{color:var(--rose)}

/* ── CARDS ── */
.card{background:#fff;border-radius:var(--radius-md);box-shadow:var(--shadow-sm);margin-bottom:20px}
.card-header{padding:18px 22px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}
.card-header h3{font-size:15px;font-weight:700;color:var(--navy)}
.card-body{padding:22px}
.section-title{font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.8px;margin-bottom:14px}
.chart-wrap{position:relative;height:220px}

/* ── BADGES ── */
.badge{display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600;white-space:nowrap}
.badge-active     {background:#EFF6FF;color:#2563EB}
.badge-in-progress{background:#EDE9FE;color:#7C3AED}
.badge-review     {background:#FFF7ED;color:#D97706}
.badge-on-hold    {background:#F3F4F6;color:#6B7280}
.badge-completed  {background:#F0FDF4;color:#16A34A}
.badge-cancelled  {background:#FFF1F2;color:#E11D48}
.badge-closed     {background:#F0FDF4;color:#15803D}
.badge-dismissed  {background:#FFF1F2;color:#BE123C}
.badge-high       {background:#FEF2F2;color:#DC2626}
.badge-medium     {background:#FFFBEB;color:#B45309}
.badge-low        {background:#F0FDF4;color:#15803D}

/* ── PROJECT TABLE ── */
.proj-table-wrap{overflow-x:auto;border-radius:0 0 12px 12px}
.proj-table{width:100%;border-collapse:collapse}
.proj-table thead{z-index:20;will-change:transform}
.proj-table th{text-align:left;font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;padding:10px 14px;border-bottom:1.5px solid var(--border);background:#FAFAFA;white-space:nowrap}
.proj-table th.sortable{cursor:pointer;user-select:none}
.proj-table th.sortable:hover{color:var(--indigo);background:#F0F1FF}
.proj-table th.sort-active{color:var(--indigo)}
.sort-icon{display:inline-flex;flex-direction:column;gap:1px;margin-left:5px;vertical-align:middle;opacity:.35}
.sort-icon.asc .arr-up,.sort-icon.desc .arr-dn{opacity:1}
.sort-icon svg{width:8px;height:8px}
.proj-table td{padding:12px 14px;border-bottom:1px solid #F3F4F6;vertical-align:middle;font-size:13px}
.proj-table tr:last-child td{border-bottom:none}
.proj-table tbody tr{transition:background .12s}
.proj-table tbody tr:hover td{background:#F8F9FF}
.proj-table tbody tr:hover td.cb-col,.proj-table tbody tr:hover td.num-col{background:#F8F9FF}
.proj-name{font-weight:600;color:var(--navy)}
.proj-notes-cell{max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--muted);font-size:12px}
.num-col{width:36px;padding-left:14px;padding-right:0;color:var(--muted);font-size:11px;font-weight:500;text-align:right}
th.num-col{text-align:right}
.overdue-chip{display:inline-flex;align-items:center;gap:3px;background:#FEF2F2;color:#DC2626;border:1px solid #FECACA;border-radius:4px;font-size:10px;font-weight:600;padding:1px 5px;margin-left:5px;vertical-align:middle}
.proj-count{font-size:12px;color:var(--muted);margin-left:auto;white-space:nowrap;align-self:center}

/* ── MEMBER GRID ── */
.member-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:14px}
.member-card{background:#fff;border-radius:var(--radius-md);padding:18px;box-shadow:var(--shadow-sm);border-left:4px solid var(--indigo);transition:all .15s}
.member-card:hover{transform:translateY(-2px);box-shadow:var(--shadow-md)}
.member-header{display:flex;align-items:center;gap:10px;margin-bottom:14px}
.member-avatar{width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;color:#fff;flex-shrink:0}
.member-info .name{font-weight:600;font-size:14px;color:var(--navy)}
.member-info .em{font-size:11px;color:var(--muted)}
.member-stats-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.ms{background:#F8FAFC;border-radius:var(--radius-sm);padding:8px 10px}
.ms .v{font-size:20px;font-weight:700}
.ms .l{font-size:10px;color:#94A3B8;font-weight:500}
.ms.done .v{color:var(--green)}
.ms.prog .v{color:#3B82F6}
.ms.rev  .v{color:var(--gold)}
.ms.back .v{color:var(--muted)}

/* ── CHIP ── */
.chip-group{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px}
.chip{display:inline-flex;align-items:center;gap:4px;background:#EEF2FF;color:var(--indigo);border-radius:20px;padding:3px 10px;font-size:12px;font-weight:500}
.chip .rm{cursor:pointer;opacity:.6;font-size:13px;line-height:1;margin-left:2px;transition:opacity .1s}
.chip .rm:hover{opacity:1}

/* ── MODAL ── */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:500;display:none;align-items:center;justify-content:center;padding:20px}
.modal-overlay.open{display:flex;animation:fadeIn .18s ease}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
.modal{background:#fff;border-radius:var(--radius-xl);padding:32px 34px;width:100%;max-width:560px;max-height:90vh;overflow-y:auto;box-shadow:var(--shadow-lg);animation:slideUp .2s ease}
@keyframes slideUp{from{transform:translateY(16px);opacity:0}to{transform:translateY(0);opacity:1}}
.modal-title{font-size:18px;font-weight:700;color:var(--navy);margin-bottom:22px;display:flex;align-items:center;justify-content:space-between}
.modal-footer{display:flex;gap:10px;justify-content:flex-end;margin-top:24px;padding-top:20px;border-top:1px solid var(--border)}
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:14px}

/* ── KPI SLIDE-OVER ── */
.panel-overlay{position:fixed;inset:0;background:rgba(0,0,0,.3);z-index:300;opacity:0;pointer-events:none;transition:opacity .25s}
.panel-overlay.open{opacity:1;pointer-events:auto}
.kpi-panel{position:fixed;top:0;right:0;width:460px;max-width:100vw;height:100vh;background:#fff;z-index:301;box-shadow:-6px 0 40px rgba(0,0,0,.14);transform:translateX(100%);transition:transform .28s cubic-bezier(.32,.72,0,1);display:flex;flex-direction:column;overflow:hidden}
.kpi-panel.open{transform:none}
.kpi-panel-head{padding:22px 24px 18px;border-bottom:1px solid var(--border);display:flex;align-items:flex-start;gap:14px;flex-shrink:0}
.kpi-panel-icon{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.kpi-panel-icon svg{width:22px;height:22px}
.kpi-panel-title{font-size:18px;font-weight:700;color:var(--navy)}
.kpi-panel-subtitle{font-size:12px;color:var(--muted);margin-top:2px}
.kpi-panel-body{flex:1;overflow-y:auto;padding:16px 24px}
.kpi-task-row{display:flex;align-items:center;gap:12px;padding:11px 0;border-bottom:1px solid #F3F4F6}
.kpi-task-row:last-child{border-bottom:none}
.kpi-task-av{width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#fff;flex-shrink:0}
.kpi-task-info{flex:1;min-width:0}
.kpi-task-name{font-size:13px;font-weight:600;color:var(--navy);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.kpi-task-meta{font-size:11px;color:var(--muted);margin-top:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.kpi-member-row{display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid #F3F4F6}
.kpi-member-row:last-child{border-bottom:none}
.kpi-member-stats{display:flex;gap:14px;margin-left:auto;flex-shrink:0}
.kpi-member-stat{text-align:right}
.kpi-member-stat .v{font-size:16px;font-weight:700;color:var(--navy)}
.kpi-member-stat .l{font-size:10px;color:var(--muted)}
.kpi-panel-empty{padding:60px 20px;text-align:center;color:var(--muted)}
.kpi-panel-empty svg{width:48px;height:48px;margin:0 auto 14px;opacity:.25}
.kpi-panel-empty p{font-size:13px}

/* ── PROFILE MODAL EXTRAS ── */
.photo-upload-area{display:flex;flex-direction:column;align-items:center;gap:14px;margin-bottom:22px}
.photo-preview{width:80px;height:80px;border-radius:50%;background:linear-gradient(135deg,var(--indigo),var(--purple));display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:700;color:#fff;overflow:hidden;position:relative;cursor:pointer;transition:all .15s}
.photo-preview:hover::after{content:'📷';position:absolute;inset:0;background:rgba(0,0,0,.45);display:flex;align-items:center;justify-content:center;font-size:22px;border-radius:50%}
.photo-preview img{width:100%;height:100%;object-fit:cover;border-radius:50%}
.photo-hint{font-size:12px;color:var(--muted);text-align:center}

/* ── INVITE ── */
.invite-card{background:linear-gradient(135deg,var(--navy),#1e3a8a);border-radius:var(--radius-lg);padding:28px;color:#fff;margin-bottom:20px}
.invite-card h3{font-size:18px;font-weight:700;margin-bottom:8px}
.invite-card p{font-size:13px;opacity:.75;margin-bottom:20px}
.url-box{background:rgba(255,255,255,.12);border-radius:var(--radius-sm);padding:12px 16px;display:flex;align-items:center;justify-content:space-between;gap:10px}
.url-box span{font-size:13px;font-family:monospace;word-break:break-all;opacity:.9}
.url-box button{background:rgba(255,255,255,.2);border:none;color:#fff;padding:6px 12px;border-radius:6px;font-size:12px;cursor:pointer;white-space:nowrap;font-weight:600;font-family:inherit;transition:background .15s}
.url-box button:hover{background:rgba(255,255,255,.3)}
.invite-step{display:flex;gap:14px;align-items:flex-start;margin-bottom:16px}
.step-num{width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,var(--indigo),var(--purple));color:#fff;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;flex-shrink:0;margin-top:2px}
.step-text h4{font-size:14px;font-weight:600;color:var(--navy);margin-bottom:2px}
.step-text p{font-size:12px;color:var(--muted)}
.user-pill{display:flex;align-items:center;gap:10px;background:var(--bg);border-radius:var(--radius-sm);padding:10px 14px;margin-bottom:8px}
.user-pill .av{width:30px;height:30px;border-radius:50%;background:linear-gradient(135deg,var(--indigo),var(--purple));display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#fff}
.user-pill .info .nm{font-size:13px;font-weight:600}
.user-pill .info .em{font-size:11px;color:var(--muted)}

/* ── SETTINGS ── */
.settings-section{background:#fff;border-radius:var(--radius-md);padding:24px;box-shadow:var(--shadow-sm);margin-bottom:20px}
.settings-section h3{font-size:15px;font-weight:700;color:var(--navy);margin-bottom:16px;padding-bottom:12px;border-bottom:1px solid var(--border)}
.settings-row{display:flex;align-items:center;justify-content:space-between;padding:12px 0;border-bottom:1px solid #F9FAFB;gap:12px}
.settings-row:last-child{border-bottom:none;padding-bottom:0}
.settings-row .lbl{font-size:13px;font-weight:500}
.settings-row .hint{font-size:11px;color:var(--muted);margin-top:2px}

/* ── FILTER ROW ── */
.filter-row{display:flex;align-items:center;gap:10px;margin-bottom:18px;flex-wrap:wrap;position:sticky;top:var(--topbar-h,52px);z-index:40;background:#F9FAFB;padding:10px 0;margin-top:-10px}
.filter-row select,.filter-row input[type=text]{padding:8px 12px;border:1.5px solid var(--border);border-radius:var(--radius-sm);font-size:13px;color:var(--text);background:#fff;outline:none;font-family:inherit;transition:border .15s}
.filter-row select:focus,.filter-row input[type=text]:focus{border-color:var(--indigo)}
.filter-row label{font-size:12px;color:var(--muted);font-weight:500}

/* ── CONNECT BANNER ── */
.connect-banner{background:linear-gradient(135deg,var(--indigo),var(--purple));border-radius:var(--radius-md);padding:22px 26px;color:#fff;display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:24px}
.connect-banner h3{font-size:15px;font-weight:700;margin-bottom:4px}
.connect-banner p{font-size:12px;opacity:.8}
.connect-banner .btn{background:rgba(255,255,255,.2);color:#fff;border:1px solid rgba(255,255,255,.3);width:auto}
.connect-banner .btn:hover{background:rgba(255,255,255,.3);transform:none}

/* ── TOAST ── */
.toast{position:fixed;bottom:24px;right:24px;background:#1F2937;color:#fff;padding:12px 20px;border-radius:var(--radius-md);font-size:13px;font-weight:500;z-index:9999;transform:translateY(80px);opacity:0;transition:all .3s;pointer-events:none;max-width:340px}
.toast.show{transform:translateY(0);opacity:1}
.toast.success{background:#065F46}
.toast.error{background:#991B1B}

/* ── EMPTY STATE ── */
.empty-state{text-align:center;padding:60px 20px;color:var(--muted)}
.empty-state svg{width:52px;height:52px;margin:0 auto 16px;opacity:.25}
.empty-state h3{font-size:15px;font-weight:600;margin-bottom:6px;color:#374151}
.empty-state p{font-size:13px}

/* ── RESPONSIVE ── */
@media(max-width:768px){
  .sidebar{transform:translateX(-100%);transition:.25s;z-index:200}
  .sidebar.open{transform:none}
  .main-content{margin-left:0}
  .stat-grid{grid-template-columns:repeat(2,1fr)}
  .two-col{grid-template-columns:1fr}
  .kpi-panel{width:100vw}
  .topbar{padding:12px 16px}
  .page-body{padding:16px}
}
.hidden{display:none!important}
/* ── Checkboxes & bulk bar ── */
.proj-cb{width:16px;height:16px;accent-color:var(--indigo);cursor:pointer;flex-shrink:0}
th.cb-col,td.cb-col{width:36px;padding-left:14px;padding-right:0}
.bulk-bar{display:none;align-items:center;gap:10px;padding:10px 16px;background:#EEF2FF;border-bottom:1px solid #C7D2FE;font-size:13px;font-weight:500;color:var(--indigo)}
.bulk-bar.visible{display:flex}
.bulk-bar-count{font-weight:700;margin-right:4px}
.bulk-bar-spacer{flex:1}
.bulk-bar .btn{font-size:12px;padding:5px 12px;height:auto}
/* ── Project detail panel ── */
.proj-panel{position:fixed;top:0;right:0;width:500px;max-width:100vw;height:100vh;background:#fff;z-index:302;box-shadow:-6px 0 40px rgba(0,0,0,.14);transform:translateX(100%);transition:transform .28s cubic-bezier(.32,.72,0,1);display:flex;flex-direction:column;overflow:hidden}
.proj-panel.open{transform:none}
.proj-panel-head{padding:22px 24px 18px;border-bottom:1px solid var(--border);display:flex;align-items:flex-start;gap:12px;flex-shrink:0}
.proj-panel-title{font-size:19px;font-weight:700;color:var(--navy);flex:1;min-width:0;word-break:break-word}
.proj-panel-body{flex:1;overflow-y:auto;padding:20px 24px;display:flex;flex-direction:column;gap:20px}
.proj-detail-section{display:flex;flex-direction:column;gap:6px}
.proj-detail-label{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--muted)}
.proj-detail-value{font-size:14px;color:var(--navy)}
.proj-detail-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px}
.proj-panel-footer{padding:16px 24px;border-top:1px solid var(--border);display:flex;gap:10px;flex-shrink:0}
.proj-panel-footer .btn{flex:1}
tr.proj-row{cursor:pointer}
tr.proj-row:hover td{background:#F8F9FF}
/* ── Dropdown menus ── */
.dropdown-wrap{position:relative;display:inline-block}
.dropdown-menu{display:none;position:absolute;right:0;top:calc(100% + 6px);background:#fff;border:1px solid #E5E7EB;border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,.12);min-width:168px;z-index:500;overflow:hidden}
.dropdown-menu.open{display:block}
.dropdown-item{display:flex;align-items:center;gap:9px;padding:10px 14px;font-size:13px;color:#374151;cursor:pointer;transition:background .15s;white-space:nowrap;border:none;background:none;width:100%;text-align:left}
.dropdown-item:hover{background:#F5F6FF;color:var(--indigo)}
.dropdown-item svg{flex-shrink:0;opacity:.7}
.dropdown-divider{height:1px;background:#F3F4F6;margin:4px 0}
.dropdown-toggle-caret{display:inline-flex;align-items:center;gap:5px}

/* ── DRAFT BADGE ── */
.draft-badge{font-size:10px;font-weight:600;background:#FEF3C7;color:#92400E;border:1px solid #FDE68A;padding:2px 7px;border-radius:20px;margin-left:10px;vertical-align:middle}

/* ── RICH TEXT EDITOR (RTE) ── */
.rte-wrap{border:1.5px solid var(--border);border-radius:var(--radius-sm);overflow:hidden;transition:border .15s}
.rte-wrap:focus-within{border-color:var(--indigo);box-shadow:0 0 0 3px rgba(99,102,241,.12)}
.rte-toolbar{display:flex;align-items:center;gap:2px;padding:6px 8px;background:#F9FAFB;border-bottom:1px solid var(--border);flex-wrap:wrap}
.rte-btn{display:inline-flex;align-items:center;justify-content:center;width:30px;height:28px;border:none;background:none;border-radius:5px;cursor:pointer;color:var(--muted);font-size:13px;font-weight:700;font-family:inherit;transition:all .12s}
.rte-btn:hover{background:#EEF2FF;color:var(--indigo)}
.rte-btn.active{background:#EEF2FF;color:var(--indigo)}
.rte-divider{width:1px;height:18px;background:var(--border);margin:0 4px}
.rte-editor{min-height:160px;max-height:360px;overflow-y:auto;padding:12px 14px;font-size:14px;line-height:1.7;color:var(--text);outline:none;font-family:inherit}
.rte-editor:empty::before{content:attr(data-placeholder);color:#9CA3AF;pointer-events:none}
.rte-editor ul,.rte-editor ol{padding-left:22px}
.rte-editor li{margin-bottom:2px}
.rte-editor b,.rte-editor strong{font-weight:700;color:var(--navy)}

/* ── WEEKLY STATUS REPORTS PAGE ── */
.reports-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:16px}
.report-card{background:#fff;border-radius:var(--radius-md);box-shadow:var(--shadow-sm);overflow:hidden;border:1.5px solid transparent;transition:all .18s;cursor:pointer}
.report-card:hover{border-color:var(--indigo);transform:translateY(-2px);box-shadow:var(--shadow-md)}
.report-card-head{padding:16px 18px 12px;border-bottom:1px solid #F3F4F6}
.report-card-week{font-size:13px;font-weight:700;color:var(--navy);margin-bottom:3px}
.report-card-meta{font-size:11px;color:var(--muted)}
.report-card-body{padding:14px 18px;font-size:13px;color:var(--text);line-height:1.6;max-height:110px;overflow:hidden;position:relative}
.report-card-body::after{content:'';position:absolute;bottom:0;left:0;right:0;height:32px;background:linear-gradient(transparent,#fff)}
.report-card-foot{padding:10px 14px;display:flex;align-items:center;gap:8px;border-top:1px solid #F3F4F6}
.report-empty{text-align:center;padding:60px 20px;color:var(--muted)}
.report-empty svg{width:52px;height:52px;margin:0 auto 14px;opacity:.2}
.report-empty p{font-size:14px}

/* ── PUBLIC REPORT OVERLAY ── */
#public-report-overlay{position:fixed;inset:0;background:#F0F2F8;z-index:9000;display:none;overflow-y:auto}
#public-report-overlay.open{display:block}
.pub-report-wrap{max-width:760px;margin:48px auto;padding:0 20px 80px}
.pub-report-header{background:linear-gradient(135deg,var(--navy) 0%,#1e3a8a 100%);border-radius:var(--radius-xl);padding:36px 40px;color:#fff;margin-bottom:28px}
.pub-report-logo{font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;opacity:.6;margin-bottom:20px}
.pub-report-title{font-size:28px;font-weight:800;margin-bottom:8px;letter-spacing:-.5px}
.pub-report-week{font-size:14px;opacity:.75}
.pub-report-body{background:#fff;border-radius:var(--radius-xl);padding:36px 40px;box-shadow:var(--shadow-md);font-size:15px;line-height:1.8;color:var(--text)}
.pub-report-body ul,.pub-report-body ol{padding-left:24px;margin:8px 0}
.pub-report-body li{margin-bottom:6px}
.pub-report-footer{text-align:center;margin-top:28px;font-size:12px;color:var(--muted)}
</style>
</head>
<body>
<a href="#main-content" class="skip-link">Skip to content</a>
<div aria-live="polite" aria-atomic="true" class="sr-only" id="live-region" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)"></div>

<!-- Logo data injected by JS from embedded data URIs -->
<img id="logo-light-el" src="data:image/svg+xml;base64," alt="Dot2Shape" style="display:none">
<img id="logo-dark-el"  src="data:image/svg+xml;base64,"  alt="Dot2Shape" style="display:none">

<!-- ═══════════ LOGIN ═══════════ -->
<div id="screen-login" class="auth-wrap" role="main">
  <div class="auth-card">
    <div class="auth-logo"><img src="data:image/svg+xml;base64," alt="Dot2Shape" style="width:200px;height:auto"/></div>
    <h1 class="auth-title">Welcome back</h1>
    <p class="auth-sub">Sign in to your team portal</p>
    <div class="field">
      <label for="login-email">Email address</label>
      <input id="login-email" type="email" placeholder="you@dot2shape.com" autocomplete="email" onkeydown="if(event.key==='Enter')doLogin()"/>
    </div>
    <div class="field">
      <label for="login-pass">Password</label>
      <input id="login-pass" type="password" placeholder="Enter your password" autocomplete="current-password" onkeydown="if(event.key==='Enter')doLogin()"/>
    </div>
    <div class="err-msg" id="login-err" role="alert"></div>
    <button class="btn btn-primary" onclick="doLogin()">Sign In</button>
    <p class="auth-footer">No account yet? <a href="#" onclick="showScreen('screen-register');return false">Create password</a></p>
  </div>
</div>

<!-- ═══════════ REGISTER ═══════════ -->
<div id="screen-register" class="auth-wrap hidden" role="main">
  <div class="auth-card">
    <div class="auth-logo"><img src="data:image/svg+xml;base64," alt="Dot2Shape" style="width:200px;height:auto"/></div>
    <h1 class="auth-title">Create your password</h1>
    <p class="auth-sub">Set up access for your dot2shape account</p>
    <div class="field">
      <label for="reg-email">Email address</label>
      <input id="reg-email" type="email" placeholder="you@dot2shape.com" autocomplete="email"/>
    </div>
    <div class="field">
      <label for="reg-pass">Choose a password</label>
      <input id="reg-pass" type="password" placeholder="Min 8 characters" autocomplete="new-password"/>
    </div>
    <div class="field">
      <label for="reg-pass2">Confirm password</label>
      <input id="reg-pass2" type="password" placeholder="Repeat password" autocomplete="new-password" onkeydown="if(event.key==='Enter')doRegister()"/>
    </div>
    <div class="err-msg" id="reg-err" role="alert"></div>
    <button class="btn btn-primary" onclick="doRegister()">Create Account</button>
    <p class="auth-footer">Already have a password? <a href="#" onclick="showScreen('screen-login');return false">Sign in</a></p>
  </div>
</div>

<!-- ═══════════ APP ═══════════ -->
<div id="screen-app" class="hidden">

  <aside class="sidebar" role="navigation" aria-label="Main navigation">
    <div class="sidebar-logo"><img src="data:image/svg+xml;base64," alt="Dot2Shape" style="width:160px;height:auto;display:block"/></div>

    <!-- Profile button -->
    <button class="sb-profile-btn" id="sb-profile-btn" onclick="openProfileModal()" aria-label="Edit your profile">
      <div class="sb-avatar" id="sb-avatar" aria-hidden="true">BS</div>
      <div class="sb-user-info">
        <div class="name" id="sb-name">Bisma Siddiqi</div>
        <div class="email" id="sb-email">bisma@dot2shape.com</div>
      </div>
      <svg class="sb-edit-hint" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.5)" stroke-width="2" style="width:14px;height:14px;flex-shrink:0" aria-hidden="true"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
    </button>

    <nav>
      <div class="nav-section">Main</div>
      <button class="nav-item active" data-page="dashboard" onclick="navTo('dashboard')" aria-current="page">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
        Dashboard
      </button>
      <button class="nav-item" data-page="projects" onclick="navTo('projects')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        Projects Log
      </button>
      <div class="nav-section">Team</div>
      <button class="nav-item" data-page="invite" onclick="navTo('invite')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
        Invite & Access
      </button>
      <div class="nav-section">Reports</div>
      <button class="nav-item" data-page="reports" onclick="navTo('reports')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="8" y1="14" x2="8" y2="14"/><line x1="12" y1="14" x2="16" y2="14"/><line x1="8" y1="18" x2="8" y2="18"/><line x1="12" y1="18" x2="16" y2="18"/></svg>
        Weekly Status
      </button>
      <div class="nav-section">Account</div>
      <button class="nav-item" data-page="settings" onclick="navTo('settings')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
        Settings
      </button>
    </nav>

    <div class="sidebar-footer">
      <button class="btn btn-secondary" onclick="logout()" style="width:100%;font-size:12px;color:rgba(255,255,255,.55);border-color:rgba(255,255,255,.12);background:transparent">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px" aria-hidden="true"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Sign Out
      </button>
    </div>
  </aside>

  <main class="main-content" id="main-content">

    <!-- ── DASHBOARD ── -->
    <div id="page-dashboard" class="page active" role="region" aria-label="Dashboard">
      <div class="topbar">
        <h2 class="topbar-title">Dashboard</h2>
        <div class="topbar-actions">
          <span id="dash-last-refresh" style="font-size:12px;color:var(--muted)" aria-live="polite"></span>
          <button class="btn btn-secondary btn-sm" onclick="loadDashboard()" aria-label="Refresh dashboard data">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:13px;height:13px" aria-hidden="true"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 11-2.12-9.36L23 10"/></svg>
            Refresh
          </button>
        </div>
      </div>
      <div class="page-body">
        <div id="dash-connect-banner" class="connect-banner hidden" role="alert">
          <div>
            <h3>Connect ClickUp to see live data</h3>
            <p>Add your ClickUp Personal API Token in Settings to load team stats, charts, and member performance.</p>
          </div>
          <button class="btn" onclick="navTo('settings')">Connect ClickUp →</button>
        </div>

        <div id="dash-content">
          <p class="section-title">Workspace Overview</p>
          <div class="stat-grid" id="stat-grid" role="list"></div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:24px" id="charts-grid">
            <div class="card">
              <div class="card-header"><h3>Task Status Distribution</h3></div>
              <div class="card-body"><div class="chart-wrap"><canvas id="statusChart" aria-label="Doughnut chart of task status distribution" role="img"></canvas></div></div>
            </div>
            <div class="card">
              <div class="card-header"><h3>Tasks per Member</h3></div>
              <div class="card-body"><div class="chart-wrap"><canvas id="memberChart" aria-label="Bar chart of tasks per team member" role="img"></canvas></div></div>
            </div>
          </div>
          <div class="card">
            <div class="card-header"><h3>Team Performance</h3></div>
            <div class="card-body"><div class="member-grid" id="member-grid" role="list"></div></div>
          </div>
        </div>
      </div>
    </div>

    <!-- ── PROJECTS LOG ── -->
    <div id="page-projects" class="page" role="region" aria-label="Projects Log">
      <div class="topbar">
        <h2 class="topbar-title">Projects Log</h2>
        <div class="topbar-actions">
          <!-- Export dropdown -->
          <div class="dropdown-wrap">
            <button class="btn btn-secondary btn-sm dropdown-toggle-caret" onclick="toggleDropdown('export-menu')" aria-haspopup="true" aria-expanded="false">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:13px;height:13px" aria-hidden="true"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Export
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width:11px;height:11px" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="dropdown-menu" id="export-menu" role="menu">
              <button class="dropdown-item" onclick="exportCSV();closeDropdowns()" role="menuitem">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                Export as CSV
              </button>
              <button class="dropdown-item" onclick="exportXLSX();closeDropdowns()" role="menuitem">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="3"/></svg>
                Export as Excel
              </button>
              <div class="dropdown-divider"></div>
              <button class="dropdown-item" onclick="exportProjects();closeDropdowns()" role="menuitem">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Export as JSON
              </button>
            </div>
          </div>
          <!-- Add Project dropdown -->
          <div class="dropdown-wrap">
            <button class="btn btn-primary btn-sm dropdown-toggle-caret" onclick="toggleDropdown('add-menu')" aria-haspopup="true" aria-expanded="false">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:13px;height:13px" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              Add Project
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width:11px;height:11px" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="dropdown-menu" id="add-menu" role="menu">
              <button class="dropdown-item" onclick="openAddProject();closeDropdowns()" role="menuitem">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Add Manually
              </button>
              <div class="dropdown-divider"></div>
              <button class="dropdown-item" onclick="document.getElementById('import-csv-input').click();closeDropdowns()" role="menuitem">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                Import CSV
              </button>
              <button class="dropdown-item" onclick="document.getElementById('import-xlsx-input').click();closeDropdowns()" role="menuitem">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="3"/></svg>
                Import Excel
              </button>
            </div>
          </div>
          <!-- Hidden file inputs -->
          <input type="file" id="import-csv-input" accept=".csv" style="display:none" onchange="importCSV(event)"/>
          <input type="file" id="import-xlsx-input" accept=".xlsx,.xls" style="display:none" onchange="importXLSX(event)"/>
        </div>
      </div>
      <div class="page-body">
        <div class="filter-row" role="search" aria-label="Filter projects">
          <label for="filter-status">Status:</label>
          <select id="filter-status" onchange="renderProjects()">
            <option value="">All</option>
            <option value="active">Active</option>
            <option value="in-progress">In Progress</option>
            <option value="review">Under Review</option>
            <option value="on-hold">On Hold</option>
            <option value="completed">Completed</option>
            <option value="cancelled">Cancelled</option>
          </select>
          <label for="filter-priority">Priority:</label>
          <select id="filter-priority" onchange="renderProjects()">
            <option value="">All</option>
            <option value="high">High</option>
            <option value="medium">Medium</option>
            <option value="low">Low</option>
          </select>
          <label for="filter-search" class="hidden">Search</label>
          <input type="text" id="filter-search" placeholder="Search projects…" oninput="renderProjects()" style="min-width:200px" aria-label="Search projects"/>
          <span class="proj-count" id="proj-count" aria-live="polite"></span>
        </div>
        <div class="card" style="padding:0;overflow:clip">
          <!-- Bulk action bar -->
          <div class="bulk-bar" id="bulk-bar" role="toolbar" aria-label="Bulk actions">
            <span><span class="bulk-bar-count" id="bulk-count">0</span> selected</span>
            <div class="bulk-bar-spacer"></div>
            <div class="dropdown-wrap">
              <button class="btn btn-secondary dropdown-toggle-caret" onclick="toggleDropdown('bulk-export-menu')" style="font-size:12px;padding:5px 12px;height:auto">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:12px;height:12px"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Export Selected
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width:10px;height:10px"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
              <div class="dropdown-menu" id="bulk-export-menu" role="menu">
                <button class="dropdown-item" onclick="bulkExportCSV();closeDropdowns()" role="menuitem">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                  Export as CSV
                </button>
                <button class="dropdown-item" onclick="bulkExportXLSX();closeDropdowns()" role="menuitem">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="3"/></svg>
                  Export as Excel
                </button>
              </div>
            </div>
            <button class="btn" onclick="bulkDelete()" style="font-size:12px;padding:5px 12px;height:auto;background:#FEF2F2;color:#DC2626;border:1px solid #FECACA">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:12px;height:12px"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/></svg>
              Delete Selected
            </button>
            <button class="btn btn-secondary" onclick="clearSelection()" style="font-size:12px;padding:5px 12px;height:auto">
              Clear
            </button>
          </div>
          <div class="proj-table-wrap" role="region" aria-label="Projects table" tabindex="0">
            <table class="proj-table" aria-label="Project list">
              <thead><tr>
                <th scope="col" class="cb-col"><input type="checkbox" class="proj-cb" id="cb-select-all" onchange="toggleSelectAll(this)" aria-label="Select all projects"/></th>
                <th scope="col" class="num-col">#</th>
                <th scope="col" class="sortable" onclick="setSort('name')" id="th-name">Project Name <span class="sort-icon" id="si-name"><svg class="arr-up" viewBox="0 0 8 5"><path d="M4 0L8 5H0z" fill="currentColor"/></svg><svg class="arr-dn" viewBox="0 0 8 5"><path d="M4 5L0 0h8z" fill="currentColor"/></svg></span></th>
                <th scope="col" class="sortable" onclick="setSort('projectStatus')" id="th-projectStatus">Project Status <span class="sort-icon" id="si-projectStatus"><svg class="arr-up" viewBox="0 0 8 5"><path d="M4 0L8 5H0z" fill="currentColor"/></svg><svg class="arr-dn" viewBox="0 0 8 5"><path d="M4 5L0 0h8z" fill="currentColor"/></svg></span></th>
                <th scope="col" class="sortable" onclick="setSort('taskStatus')" id="th-taskStatus">Task Status <span class="sort-icon" id="si-taskStatus"><svg class="arr-up" viewBox="0 0 8 5"><path d="M4 0L8 5H0z" fill="currentColor"/></svg><svg class="arr-dn" viewBox="0 0 8 5"><path d="M4 5L0 0h8z" fill="currentColor"/></svg></span></th>
                <th scope="col" class="sortable" onclick="setSort('priority')" id="th-priority">Priority <span class="sort-icon" id="si-priority"><svg class="arr-up" viewBox="0 0 8 5"><path d="M4 0L8 5H0z" fill="currentColor"/></svg><svg class="arr-dn" viewBox="0 0 8 5"><path d="M4 5L0 0h8z" fill="currentColor"/></svg></span></th>
                <th scope="col" class="sortable" onclick="setSort('startDate')" id="th-startDate">Start Date <span class="sort-icon" id="si-startDate"><svg class="arr-up" viewBox="0 0 8 5"><path d="M4 0L8 5H0z" fill="currentColor"/></svg><svg class="arr-dn" viewBox="0 0 8 5"><path d="M4 5L0 0h8z" fill="currentColor"/></svg></span></th>
                <th scope="col" class="sortable" onclick="setSort('dueDate')" id="th-dueDate">Due Date <span class="sort-icon" id="si-dueDate"><svg class="arr-up" viewBox="0 0 8 5"><path d="M4 0L8 5H0z" fill="currentColor"/></svg><svg class="arr-dn" viewBox="0 0 8 5"><path d="M4 5L0 0h8z" fill="currentColor"/></svg></span></th>
                <th scope="col">Project Type</th>
                <th scope="col">Assigned To</th>
                <th scope="col">Notes</th>
                <th scope="col"><span class="hidden">Actions</span></th>
              </tr></thead>
              <tbody id="projects-tbody"></tbody>
            </table>
            <div id="projects-empty" class="empty-state hidden">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              <h3>No projects yet</h3>
              <p>Click "Add Project" to log your first project.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ── INVITE ── -->
    <div id="page-invite" class="page" role="region" aria-label="Invite and Access">
      <div class="topbar"><h2 class="topbar-title">Invite & Access</h2></div>
      <div class="page-body">
        <div class="invite-card">
          <h3>Share this portal with your team</h3>
          <p>Send this link to anyone you want to give access to the Dot2Shape team portal.</p>
          <div class="url-box">
            <span id="share-url" aria-label="Portal URL"></span>
            <button onclick="copyUrl()" aria-label="Copy portal link">Copy Link</button>
          </div>
        </div>
        <div class="card">
          <div class="card-header"><h3>How to get access</h3></div>
          <div class="card-body">
            <div class="invite-step"><div class="step-num" aria-hidden="true">1</div><div class="step-text"><h4>Open the portal link</h4><p>Share the URL above with your team member</p></div></div>
            <div class="invite-step"><div class="step-num" aria-hidden="true">2</div><div class="step-text"><h4>Click "Create password"</h4><p>New users set up their account on the login page</p></div></div>
            <div class="invite-step"><div class="step-num" aria-hidden="true">3</div><div class="step-text"><h4>Use a dot2shape.com email</h4><p>Only <strong>@dot2shape.com</strong> addresses are allowed</p></div></div>
          </div>
        </div>
        <div class="card">
          <div class="card-header"><h3>Authorised accounts</h3></div>
          <div class="card-body">
            <p style="font-size:13px;color:var(--muted);margin-bottom:16px">The following email addresses can access this portal:</p>
            <div id="allowed-users-list"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- ── SETTINGS ── -->
    <div id="page-settings" class="page" role="region" aria-label="Settings">
      <div class="topbar"><h2 class="topbar-title">Settings</h2></div>
      <div class="page-body">
        <div class="settings-section">
          <h3>ClickUp Integration</h3>
          <p style="font-size:13px;color:var(--muted);margin-bottom:16px">Connect your ClickUp account to load live team stats and task data on the dashboard.</p>
          <div class="field">
            <label for="clickup-token-input">ClickUp Personal API Token</label>
            <input id="clickup-token-input" type="password" placeholder="pk_xxxxxxxxxxxxxxx" autocomplete="off"/>
          </div>
          <p style="font-size:12px;color:var(--muted);margin-bottom:16px">Find it at <strong>ClickUp → Settings → Apps → API Token</strong></p>
          <div style="display:flex;gap:10px">
            <button class="btn btn-primary btn-sm" onclick="saveClickUpToken()" style="width:auto">Save & Connect</button>
            <button class="btn btn-secondary btn-sm" onclick="clearClickUpToken()">Disconnect</button>
          </div>
          <div id="token-status" style="font-size:12px;margin-top:10px;color:var(--green);display:none" role="status">✓ ClickUp connected</div>
        </div>
        <div class="settings-section">
          <h3>Account</h3>
          <div class="settings-row"><div><div class="lbl">Signed in as</div><div class="hint" id="settings-email"></div></div></div>
          <div class="settings-row"><div><div class="lbl">Change password</div><div class="hint">Update your login password</div></div><button class="btn btn-secondary btn-sm" onclick="openChangePw()">Change</button></div>
          <div class="settings-row"><div><div class="lbl">Edit profile</div><div class="hint">Update your display name and photo</div></div><button class="btn btn-secondary btn-sm" onclick="openProfileModal()">Edit</button></div>
        </div>
        <div class="settings-section">
          <h3>Data Sync <span style="font-size:11px;font-weight:400;color:var(--muted);margin-left:6px">Share project data across all users</span></h3>
          <p style="font-size:13px;color:var(--muted);margin-bottom:16px">Connect a free Firebase Realtime Database so all portal users see the same project data in real time. <a href="https://console.firebase.google.com/" target="_blank" rel="noopener" style="color:var(--indigo)">Create a free Firebase project →</a><br><span style="font-size:12px">In Firebase: Create project → Realtime Database → Start in test mode → copy the database URL (ends in <code>.firebaseio.com</code>)</span></p>
          <div class="field">
            <label for="fb-url-input">Firebase Realtime Database URL</label>
            <input id="fb-url-input" type="text" placeholder="https://your-project-default-rtdb.firebaseio.com" autocomplete="off"/>
          </div>
          <div style="display:flex;gap:10px;margin-top:12px">
            <button class="btn btn-primary btn-sm" onclick="saveFirebaseUrl()" style="width:auto">Save & Sync</button>
            <button class="btn btn-secondary btn-sm" onclick="clearFirebaseUrl()">Disconnect</button>
          </div>
          <div id="fb-status" style="font-size:12px;margin-top:10px;display:none" role="status"></div>
        </div>
        <div class="settings-section">
          <h3>Data</h3>
          <div class="settings-row"><div><div class="lbl">Export project data</div><div class="hint">Download all projects as JSON</div></div><button class="btn btn-secondary btn-sm" onclick="exportProjects()">Export</button></div>
          <div class="settings-row"><div><div class="lbl">Import project data</div><div class="hint">Load projects from a JSON file</div></div><button class="btn btn-secondary btn-sm" onclick="document.getElementById('import-file').click()">Import</button><input type="file" id="import-file" accept=".json" style="display:none" onchange="importProjects(event)"/></div>
        </div>
      </div>
    </div>

    <!-- ── WEEKLY STATUS REPORTS ── -->
    <div id="page-reports" class="page" role="region" aria-label="Weekly Status Reports">
      <div class="topbar">
        <h2 class="topbar-title">Weekly Status</h2>
        <div class="topbar-actions">
          <button class="btn btn-primary btn-sm" onclick="openNewReport()" style="width:auto">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width:13px;height:13px" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            New Report
          </button>
        </div>
      </div>
      <div class="page-body">
        <div id="reports-grid" class="reports-grid"></div>
        <div id="reports-empty" class="report-empty" style="display:none">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <p>No weekly reports yet.<br>Click <strong>New Report</strong> to get started.</p>
        </div>
      </div>
    </div>

  </main>
</div>

<!-- ═══════════ KPI SLIDE-OVER PANEL ═══════════ -->
<div class="panel-overlay" id="panel-overlay" onclick="closeKpiPanel()" aria-hidden="true"></div>
<div class="kpi-panel" id="kpi-panel" role="dialog" aria-modal="true" aria-labelledby="kpi-panel-title-el">
  <div class="kpi-panel-head">
    <div class="kpi-panel-icon" id="kpi-panel-icon"></div>
    <div style="flex:1;min-width:0">
      <div class="kpi-panel-title" id="kpi-panel-title-el"></div>
      <div class="kpi-panel-subtitle" id="kpi-panel-subtitle"></div>
    </div>
    <button class="btn-icon" onclick="closeKpiPanel()" aria-label="Close panel">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
  <div class="kpi-panel-body" id="kpi-panel-body"></div>
</div>

<!-- ═══════════ PROJECT DETAIL PANEL ═══════════ -->
<div class="panel-overlay" id="proj-panel-overlay" onclick="closeProjectDetail()" aria-hidden="true" style="z-index:301"></div>
<div class="proj-panel" id="proj-panel" role="dialog" aria-modal="true" aria-labelledby="proj-detail-title">
  <div class="proj-panel-head">
    <div style="flex:1;min-width:0">
      <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin-bottom:4px">Project Detail</div>
      <div class="proj-panel-title" id="proj-detail-title"></div>
    </div>
    <button class="btn-icon" onclick="closeProjectDetail()" aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
  <div class="proj-panel-body" id="proj-detail-body"></div>
  <div class="proj-panel-footer">
    <button class="btn btn-secondary" id="proj-detail-edit-btn" onclick="">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px" aria-hidden="true"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      Edit Project
    </button>
    <button class="btn" id="proj-detail-delete-btn" onclick="" style="background:#FEF2F2;color:#DC2626;border:1px solid #FECACA">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/></svg>
      Delete
    </button>
  </div>
</div>

<!-- ═══════════ PROFILE MODAL ═══════════ -->
<div class="modal-overlay" id="profile-modal" role="dialog" aria-modal="true" aria-labelledby="profile-modal-title">
  <div class="modal" style="max-width:420px">
    <div class="modal-title">
      <span id="profile-modal-title">Edit Profile</span>
      <button class="btn-icon" onclick="closeModal('profile-modal')" aria-label="Close profile editor"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
    </div>
    <div class="photo-upload-area">
      <div class="photo-preview" id="photo-preview" onclick="document.getElementById('photo-file').click()" tabindex="0" role="button" aria-label="Click to upload profile photo" onkeydown="if(event.key==='Enter'||event.key===' ')document.getElementById('photo-file').click()">
        <span id="photo-initials">BS</span>
      </div>
      <input type="file" id="photo-file" accept="image/*" style="display:none" onchange="handlePhotoUpload(event)"/>
      <p class="photo-hint">Click photo to upload<br><span style="opacity:.6;font-size:11px">JPG, PNG, GIF · max 2MB</span></p>
    </div>
    <div class="field">
      <label for="pm-display-name">Display Name</label>
      <input id="pm-display-name" type="text" placeholder="Your full name"/>
    </div>
    <div class="field">
      <label>Email address</label>
      <input type="email" id="pm-email-ro" readonly style="background:#F9FAFB;color:var(--muted);cursor:default"/>
    </div>
    <div class="modal-footer">
      <button class="btn btn-secondary" onclick="closeModal('profile-modal')">Cancel</button>
      <button class="btn btn-primary" style="width:auto" onclick="saveProfile()">Save Changes</button>
    </div>
  </div>
</div>

<!-- ═══════════ ADD/EDIT PROJECT MODAL ═══════════ -->
<div class="modal-overlay" id="project-modal" role="dialog" aria-modal="true" aria-labelledby="project-modal-title">
  <div class="modal">
    <div class="modal-title">
      <span id="project-modal-title">Add Project</span>
      <button class="btn-icon" onclick="clearDraft();closeModal('project-modal')" aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
    </div>
    <input type="hidden" id="pm-id"/>
    <div class="field"><label for="pm-name">Project Name *</label><input id="pm-name" type="text" placeholder="e.g. MotorCut — App Design" oninput="saveDraft()"/></div>
    <div class="two-col">
      <div class="field"><label for="pm-proj-status">Project Status</label>
        <select id="pm-proj-status" onchange="saveDraft()">
          <option value="active">Active</option><option value="in-progress">In Progress</option>
          <option value="review">Under Review</option><option value="on-hold">On Hold</option>
          <option value="completed">Completed</option><option value="cancelled">Cancelled</option>
        </select>
      </div>
      <div class="field"><label for="pm-task-status">Task Status</label>
        <select id="pm-task-status" onchange="saveDraft()">
          <option value="backlog">Backlog</option><option value="in-progress">In Progress</option>
          <option value="review">In Review</option><option value="under-client-review">Under Client Review</option>
          <option value="completed">Completed</option>
        </select>
      </div>
    </div>
    <div class="two-col">
      <div class="field"><label for="pm-priority">Priority</label>
        <select id="pm-priority" onchange="saveDraft()"><option value="medium">Medium</option><option value="high">High</option><option value="low">Low</option></select>
      </div>
      <div class="field"><label for="pm-client">Client</label><input id="pm-client" type="text" placeholder="Client name" oninput="saveDraft()"/></div>
    </div>
    <div class="field">
      <label>Project Type</label>
      <div style="display:flex;gap:6px">
        <input id="pm-type-input" type="text" placeholder="e.g. Web Design, Branding, Mobile App…" onkeydown="if(event.key==='Enter'){event.preventDefault();addProjectType()}"/>
        <button class="btn btn-secondary btn-sm" onclick="addProjectType()" type="button">Add</button>
      </div>
      <div class="chip-group" id="pm-types"></div>
    </div>
    <div class="two-col">
      <div class="field"><label for="pm-start">Start Date</label><input id="pm-start" type="date" oninput="saveDraft()"/></div>
      <div class="field"><label for="pm-due">Due Date</label><input id="pm-due" type="date" oninput="saveDraft()"/></div>
    </div>
    <div class="field">
      <label>Assigned To</label>
      <div style="display:flex;gap:6px">
        <input id="pm-assignee-input" type="text" placeholder="Add name and press Enter" onkeydown="if(event.key==='Enter'){event.preventDefault();addAssignee()}"/>
        <button class="btn btn-secondary btn-sm" onclick="addAssignee()" type="button">Add</button>
      </div>
      <div class="chip-group" id="pm-assignees"></div>
    </div>
    <div class="field"><label for="pm-notes">Notes</label><textarea id="pm-notes" rows="3" placeholder="Project notes, updates, context…" oninput="saveDraft()"></textarea></div>
    <div class="err-msg" id="pm-err" role="alert">Project name is required.</div>
    <div class="modal-footer">
      <button class="btn btn-secondary" onclick="clearDraft();closeModal('project-modal')">Cancel</button>
      <button class="btn btn-primary" style="width:auto" onclick="saveProject()">Save Project</button>
    </div>
  </div>
</div>

<!-- ═══════════ CHANGE PASSWORD MODAL ═══════════ -->
<div class="modal-overlay" id="change-pw-modal" role="dialog" aria-modal="true" aria-labelledby="cpw-title">
  <div class="modal" style="max-width:420px">
    <div class="modal-title">
      <span id="cpw-title">Change Password</span>
      <button class="btn-icon" onclick="closeModal('change-pw-modal')" aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
    </div>
    <div class="field"><label for="cpw-current">Current Password</label><input id="cpw-current" type="password" autocomplete="current-password"/></div>
    <div class="field"><label for="cpw-new">New Password</label><input id="cpw-new" type="password" placeholder="Min 8 characters" autocomplete="new-password"/></div>
    <div class="field"><label for="cpw-confirm">Confirm New Password</label><input id="cpw-confirm" type="password" autocomplete="new-password"/></div>
    <div class="err-msg" id="cpw-err" role="alert"></div>
    <div class="modal-footer">
      <button class="btn btn-secondary" onclick="closeModal('change-pw-modal')">Cancel</button>
      <button class="btn btn-primary" style="width:auto" onclick="changePassword()">Update Password</button>
    </div>
  </div>
</div>

<!-- ═══════════ WEEKLY STATUS REPORT MODAL ═══════════ -->
<div class="modal-overlay" id="report-modal" role="dialog" aria-modal="true" aria-labelledby="report-modal-title">
  <div class="modal" style="max-width:640px">
    <div class="modal-title">
      <span id="report-modal-title">New Weekly Status Report</span>
      <button class="btn-icon" onclick="closeModal('report-modal')" aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
    </div>
    <input type="hidden" id="rm-id"/>
    <div class="two-col">
      <div class="field"><label for="rm-start">Week Start</label><input id="rm-start" type="date" oninput="updateReportTitle()"/></div>
      <div class="field"><label for="rm-end">Week End</label><input id="rm-end" type="date" oninput="updateReportTitle()"/></div>
    </div>
    <div class="field">
      <label>Status Update <span style="font-weight:400;color:var(--muted);font-size:10px;text-transform:none;letter-spacing:0">— rich text, paste, or type bullet points</span></label>
      <div class="rte-wrap">
        <div class="rte-toolbar" role="toolbar" aria-label="Text formatting">
          <button class="rte-btn" onclick="rteCmd('bold')" title="Bold" aria-label="Bold"><b>B</b></button>
          <button class="rte-btn" onclick="rteCmd('italic')" title="Italic" aria-label="Italic"><i>I</i></button>
          <button class="rte-btn" onclick="rteCmd('underline')" title="Underline" aria-label="Underline"><u>U</u></button>
          <div class="rte-divider"></div>
          <button class="rte-btn" onclick="rteCmd('insertUnorderedList')" title="Bullet List" aria-label="Bullet list">
            <svg viewBox="0 0 16 16" fill="currentColor" width="14" height="14"><circle cx="2" cy="4.5" r="1.5"/><rect x="5" y="3.75" width="10" height="1.5" rx=".75"/><circle cx="2" cy="9" r="1.5"/><rect x="5" y="8.25" width="10" height="1.5" rx=".75"/><circle cx="2" cy="13.5" r="1.5"/><rect x="5" y="12.75" width="10" height="1.5" rx=".75"/></svg>
          </button>
          <button class="rte-btn" onclick="rteCmd('insertOrderedList')" title="Numbered List" aria-label="Numbered list">
            <svg viewBox="0 0 16 16" fill="currentColor" width="14" height="14"><text x="0" y="5.5" font-size="5" font-weight="700">1.</text><rect x="5" y="3.75" width="10" height="1.5" rx=".75"/><text x="0" y="10" font-size="5" font-weight="700">2.</text><rect x="5" y="8.25" width="10" height="1.5" rx=".75"/><text x="0" y="14.5" font-size="5" font-weight="700">3.</text><rect x="5" y="12.75" width="10" height="1.5" rx=".75"/></svg>
          </button>
          <div class="rte-divider"></div>
          <button class="rte-btn" onclick="rteCmd('removeFormat')" title="Clear formatting" aria-label="Clear formatting" style="font-size:11px">Aa</button>
        </div>
        <div id="rm-editor" class="rte-editor" contenteditable="true" data-placeholder="Add your weekly highlights, blockers, completed items…" aria-label="Report content" role="textbox" aria-multiline="true"></div>
      </div>
    </div>
    <div class="err-msg" id="rm-err" role="alert"></div>
    <div class="modal-footer">
      <button class="btn btn-secondary" onclick="closeModal('report-modal')">Cancel</button>
      <button class="btn btn-primary" style="width:auto" onclick="saveReport()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width:13px;height:13px" aria-hidden="true"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
        Save Report
      </button>
    </div>
  </div>
</div>

<!-- ═══════════ PUBLIC REPORT VIEW (no auth required) ═══════════ -->
<div id="public-report-overlay" role="main" aria-label="Weekly Status Report">
  <div class="pub-report-wrap">
    <div class="pub-report-header">
      <div class="pub-report-logo">Dot2Shape · Team Portal</div>
      <div class="pub-report-title" id="pub-report-title">Weekly Status Report</div>
      <div class="pub-report-week" id="pub-report-week"></div>
    </div>
    <div class="pub-report-body" id="pub-report-body"></div>
    <div class="pub-report-footer">Shared by Dot2Shape team · <a href="https://dot2shape-portal.vercel.app" style="color:var(--indigo)" target="_blank">dot2shape-portal.vercel.app</a></div>
  </div>
</div>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.0/dist/chart.umd.js" crossorigin="anonymous"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js" crossorigin="anonymous"></script>
<script>
// ═══════════════════════════════════════════════════════
//  CONSTANTS
// ═══════════════════════════════════════════════════════
const ALLOWED = ['bisma@dot2shape.com','rabia@dot2shape.com'];
const CU_TEAM = '9014633511';
const CU_SPACE_D = '90143931679';
const CU_SPACE_S = '90144226288';

// ═══════════════════════════════════════════════════════
//  GLOBAL STATE
// ═══════════════════════════════════════════════════════
let _tasks = [];
let _members = {};
let _charts = [];
let _tmpAssignees = [];
let _tmpProjectTypes = [];
let _photoB64 = null; // temp during profile edit

// ═══════════════════════════════════════════════════════
//  UTILS
// ═══════════════════════════════════════════════════════
async function sha256(s){
  const b=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(s));
  return Array.from(new Uint8Array(b)).map(x=>x.toString(16).padStart(2,'0')).join('');
}
const uuid=()=>crypto.randomUUID?crypto.randomUUID():Date.now().toString(36)+Math.random().toString(36).slice(2);
function toast(msg,type=''){
  const t=document.getElementById('toast');
  t.textContent=msg; t.className='toast show '+(type||'');
  document.getElementById('live-region').textContent=msg;
  setTimeout(()=>t.classList.remove('show'),3200);
}
function initials(n){return(n||'?').split(' ').map(w=>w[0]).join('').toUpperCase().slice(0,2)}
function avatarGrad(n){
  const g=[['#6366f1','#8b5cf6'],['#3b82f6','#06b6d4'],['#10b981','#6366f1'],
            ['#f59e0b','#f43f5e'],['#8b5cf6','#ec4899'],['#06b6d4','#3b82f6']];
  return g[(n||'?').charCodeAt(0)%g.length];
}
function fmtDate(d){if(!d)return'—';const dt=new Date(d);return dt.toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'})}
function clamp(s,n){return s&&s.length>n?s.slice(0,n)+'…':s||''}
function showErr(id,msg){const e=document.getElementById(id);e.textContent=msg;e.classList.add('show')}
function hideErr(id){document.getElementById(id).classList.remove('show')}

// Logo injection - logos are now static img tags (no-op)
function injectLogo(targetId, variant='light'){}

// ═══════════════════════════════════════════════════════
//  SCREEN / MODAL HELPERS
// ═══════════════════════════════════════════════════════
function showScreen(id){
  ['screen-login','screen-register','screen-app'].forEach(s=>{
    document.getElementById(s).classList.toggle('hidden',s!==id);
  });
  // Inject logos on first show
  if(id==='screen-login') injectLogo('login-logo','light');
  if(id==='screen-register') injectLogo('reg-logo','light');
}

function openModal(id){
  const m=document.getElementById(id);
  m.classList.add('open');
  // Focus first focusable element
  setTimeout(()=>{const f=m.querySelector('input,button,select,textarea');if(f)f.focus()},50);
}
function closeModal(id){
  document.getElementById(id).classList.remove('open');
}

// Escape key closes modals and panels
document.addEventListener('keydown',e=>{
  if(e.key==='Escape'){
    document.querySelectorAll('.modal-overlay.open').forEach(m=>m.classList.remove('open'));
    closeKpiPanel();
    const pubOverlay=document.getElementById('public-report-overlay');
    if(pubOverlay&&pubOverlay.classList.contains('open')){
      pubOverlay.classList.remove('open');
      document.body.style.overflow='';
    }
  }
});
// Click-outside to close modals
document.querySelectorAll('.modal-overlay').forEach(o=>o.addEventListener('click',e=>{if(e.target===o)o.classList.remove('open')}));

// ═══════════════════════════════════════════════════════
//  AUTH
// ═══════════════════════════════════════════════════════
async function doLogin(){
  const email=document.getElementById('login-email').value.trim().toLowerCase();
  const pass=document.getElementById('login-pass').value;
  hideErr('login-err');
  if(!ALLOWED.includes(email)){showErr('login-err','This email is not authorised.');return}
  const stored=localStorage.getItem('d2s_pw_'+email);
  if(!stored){showErr('login-err','No password set. Click "Create password" to set one.');return}
  const hash=await sha256(pass);
  if(hash!==stored){showErr('login-err','Incorrect email or password. Please try again.');return}
  localStorage.setItem('d2s_session',email);
  enterApp(email);
}

async function doRegister(){
  const email=document.getElementById('reg-email').value.trim().toLowerCase();
  const pass=document.getElementById('reg-pass').value;
  const pass2=document.getElementById('reg-pass2').value;
  hideErr('reg-err');
  if(!ALLOWED.includes(email)){showErr('reg-err','Only @dot2shape.com emails are allowed.');return}
  if(pass.length<8){showErr('reg-err','Password must be at least 8 characters.');return}
  if(pass!==pass2){showErr('reg-err','Passwords do not match.');return}
  const hash=await sha256(pass);
  localStorage.setItem('d2s_pw_'+email,hash);
  localStorage.setItem('d2s_session',email);
  toast('Account created! Welcome.','success');
  enterApp(email);
}

function logout(){
  localStorage.removeItem('d2s_session');
  showScreen('screen-login');
}

function enterApp(email){
  showScreen('screen-app');
  injectLogo('sb-logo','dark');
  // Load display name
  const stored=localStorage.getItem('d2s_dname_'+email);
  const name=stored||email.split('@')[0].replace(/\./g,' ').replace(/\b\w/g,c=>c.toUpperCase());
  document.getElementById('sb-name').textContent=name;
  document.getElementById('sb-email').textContent=email;
  const inits=initials(name);
  document.getElementById('settings-email').textContent=email;
  // Avatar photo
  const photo=localStorage.getItem('d2s_photo_'+email);
  const sbAv=document.getElementById('sb-avatar');
  if(photo){sbAv.innerHTML=`<img src="${photo}" alt="${name}" />`;}
  else{sbAv.textContent=inits;}
  document.getElementById('share-url').textContent=location.href.split('#')[0];
  buildAllowedUsersList();
  checkClickUpToken();
  navTo('dashboard');
}

// ═══════════════════════════════════════════════════════
//  NAV
// ═══════════════════════════════════════════════════════
function navTo(page){
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n=>{
    const isActive=n.dataset.page===page;
    n.classList.toggle('active',isActive);
    n.setAttribute('aria-current',isActive?'page':'false');
  });
  const pg=document.getElementById('page-'+page);
  if(pg)pg.classList.add('active');
  if(page==='dashboard') loadDashboard();
  if(page==='projects'){
    syncFromCloud().then(()=>renderProjects());
    renderProjects();
    requestAnimationFrame(()=>{
      const tb=document.querySelector('#page-projects .topbar');
      document.documentElement.style.setProperty('--topbar-h',(tb?tb.offsetHeight:52)+'px');
    });
    initStickyHeader();
  }
  if(page==='invite') document.getElementById('share-url').textContent=location.href.split('#')[0];
  if(page==='settings') initFirebaseSettings();
  if(page==='reports'){
    syncReportsFromCloud().then(()=>renderReports());
    renderReports();
  }
}

// ═══════════════════════════════════════════════════════
//  PROFILE
// ═══════════════════════════════════════════════════════
function openProfileModal(){
  const email=localStorage.getItem('d2s_session')||'';
  const stored=localStorage.getItem('d2s_dname_'+email)||'';
  document.getElementById('pm-display-name').value=stored;
  document.getElementById('pm-email-ro').value=email;
  const photo=localStorage.getItem('d2s_photo_'+email);
  const prev=document.getElementById('photo-preview');
  const inits=initials(stored||email.split('@')[0].replace(/\./g,' ').replace(/\b\w/g,c=>c.toUpperCase()));
  document.getElementById('photo-initials').textContent=inits;
  if(photo){
    prev.innerHTML=`<img src="${photo}" alt="Profile photo" style="width:100%;height:100%;object-fit:cover;border-radius:50%"/>`;
  }
  _photoB64=null;
  openModal('profile-modal');
}

function handlePhotoUpload(e){
  const file=e.target.files[0];
  if(!file)return;
  if(file.size>2*1024*1024){toast('Image too large. Max 2MB.','error');return}
  const reader=new FileReader();
  reader.onload=ev=>{
    _photoB64=ev.target.result;
    const prev=document.getElementById('photo-preview');
    prev.innerHTML=`<img src="${_photoB64}" alt="Profile photo preview" style="width:100%;height:100%;object-fit:cover;border-radius:50%"/>`;
  };
  reader.readAsDataURL(file);
}

function saveProfile(){
  const email=localStorage.getItem('d2s_session')||'';
  const name=document.getElementById('pm-display-name').value.trim();
  if(!name){toast('Please enter a display name','error');return}
  localStorage.setItem('d2s_dname_'+email,name);
  if(_photoB64){
    localStorage.setItem('d2s_photo_'+email,_photoB64);
    const sbAv=document.getElementById('sb-avatar');
    sbAv.innerHTML=`<img src="${_photoB64}" alt="${name}" />`;
  }
  document.getElementById('sb-name').textContent=name;
  closeModal('profile-modal');
  toast('Profile updated!','success');
}

// ═══════════════════════════════════════════════════════
//  CLICKUP TOKEN
// ═══════════════════════════════════════════════════════
function checkClickUpToken(){
  const t=localStorage.getItem('d2s_cu_token');
  if(t){document.getElementById('clickup-token-input').value=t;document.getElementById('token-status').style.display='block';}
  document.getElementById('dash-connect-banner').classList.toggle('hidden',!!t);
}
function saveClickUpToken(){
  const t=document.getElementById('clickup-token-input').value.trim();
  if(!t){toast('Enter your API token first','error');return}
  localStorage.setItem('d2s_cu_token',t);
  document.getElementById('token-status').style.display='block';
  document.getElementById('dash-connect-banner').classList.add('hidden');
  toast('ClickUp connected!','success');
  loadDashboard();
}
function clearClickUpToken(){
  localStorage.removeItem('d2s_cu_token');
  document.getElementById('clickup-token-input').value='';
  document.getElementById('token-status').style.display='none';
  document.getElementById('dash-connect-banner').classList.remove('hidden');
  toast('ClickUp disconnected');
}

// ═══════════════════════════════════════════════════════
//  DASHBOARD
// ═══════════════════════════════════════════════════════
async function loadDashboard(){
  const token=localStorage.getItem('d2s_cu_token');
  if(!token){
    document.getElementById('dash-connect-banner').classList.remove('hidden');
    document.getElementById('stat-grid').innerHTML='';
    return;
  }
  document.getElementById('dash-connect-banner').classList.add('hidden');
  try{
    const tmRes=await fetch(`https://api.clickup.com/api/v2/team`,{headers:{'Authorization':token}});
    const tmJson=await tmRes.json();
    const members=(tmJson.teams?.[0]?.members||[]);
    const activeIds=new Set(members.map(m=>m.user.id));
    members.forEach(m=>{_members[m.user.id]={name:m.user.username,email:m.user.email,id:m.user.id}});

    const [p0,p1]=await Promise.all([
      fetch(`https://api.clickup.com/api/v2/team/${CU_TEAM}/task?include_closed=true&subtasks=false&page=0&space_ids[]=${CU_SPACE_D}&space_ids[]=${CU_SPACE_S}`,{headers:{'Authorization':token}}),
      fetch(`https://api.clickup.com/api/v2/team/${CU_TEAM}/task?include_closed=true&subtasks=false&page=1&space_ids[]=${CU_SPACE_D}&space_ids[]=${CU_SPACE_S}`,{headers:{'Authorization':token}})
    ]);
    const [d0,d1]=await Promise.all([p0.json(),p1.json()]);
    _tasks=[...(d0.tasks||[]),...(d1.tasks||[])];

    const activeTasks=_tasks.filter(t=>t.assignees?.some(a=>activeIds.has(a.id)));
    const done=activeTasks.filter(t=>['completed','done'].includes((t.status?.status||'').toLowerCase()));
    const prog=activeTasks.filter(t=>(t.status?.status||'').toLowerCase()==='in progress');
    const rev=activeTasks.filter(t=>['review','under client review'].includes((t.status?.status||'').toLowerCase()));
    const back=activeTasks.filter(t=>(t.status?.status||'').toLowerCase()==='backlog');

    // Stat cards
    document.getElementById('stat-grid').innerHTML=[
      {key:'members',label:'Active Members',val:members.length,sub:'Deactivated excluded',cls:'c-indigo',caret:'View members →',
        icon:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>'},
      {key:'completed',label:'Completed',val:done.length,sub:'Tasks done',cls:'c-green',caret:'View completed →',
        icon:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>'},
      {key:'in-progress',label:'In Progress',val:prog.length,sub:'Being worked on',cls:'c-sky',caret:'View in progress →',
        icon:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>'},
      {key:'review',label:'In Review',val:rev.length,sub:'Awaiting review',cls:'c-amber',caret:'View in review →',
        icon:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>'},
      {key:'backlog',label:'Backlog',val:back.length,sub:'Queued',cls:'c-rose',caret:'View backlog →',
        icon:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>'}
    ].map(c=>`
      <div class="stat-card ${c.cls}" role="listitem button" tabindex="0"
        onclick="openKpiPanel('${c.key}')"
        onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openKpiPanel('${c.key}')}"
        aria-label="${c.label}: ${c.val}. Click to view details">
        <div class="s-icon">${c.icon}</div>
        <div class="s-label">${c.label}</div>
        <div class="s-val">${c.val}</div>
        <div class="s-sub">${c.sub}</div>
        <div class="s-caret">${c.caret}</div>
      </div>`).join('');

    document.getElementById('dash-last-refresh').textContent='Updated '+new Date().toLocaleTimeString();

    // Charts
    _charts.forEach(c=>c.destroy()); _charts=[];
    const sc=document.getElementById('statusChart').getContext('2d');
    _charts.push(new Chart(sc,{type:'doughnut',data:{
      labels:['Completed','In Progress','In Review','Backlog'],
      datasets:[{data:[done.length,prog.length,rev.length,back.length],backgroundColor:['#10b981','#3b82f6','#a855f7','#d1d5db'],borderWidth:0,borderRadius:4}]
    },options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'right',labels:{font:{size:12},padding:12,boxWidth:12}}},cutout:'68%'}}));

    const mStats={};
    members.forEach(m=>{mStats[m.user.id]={name:m.user.username,email:m.user.email,done:0,prog:0,rev:0,back:0,total:0}});
    activeTasks.forEach(t=>{
      const s=(t.status?.status||'').toLowerCase();
      t.assignees.forEach(a=>{
        if(!mStats[a.id])return;
        mStats[a.id].total++;
        if(['completed','done'].includes(s))mStats[a.id].done++;
        else if(s==='in progress')mStats[a.id].prog++;
        else if(['review','under client review'].includes(s))mStats[a.id].rev++;
        else mStats[a.id].back++;
      });
    });
    const top=Object.values(mStats).filter(m=>m.total>0).sort((a,b)=>b.total-a.total).slice(0,10);
    const mc=document.getElementById('memberChart').getContext('2d');
    _charts.push(new Chart(mc,{type:'bar',data:{
      labels:top.map(m=>m.name.split(' ')[0]),
      datasets:[
        {label:'Done',data:top.map(m=>m.done),backgroundColor:'#10b981',borderRadius:3},
        {label:'Active',data:top.map(m=>m.prog),backgroundColor:'#3b82f6',borderRadius:3},
        {label:'Review',data:top.map(m=>m.rev),backgroundColor:'#a855f7',borderRadius:3},
        {label:'Backlog',data:top.map(m=>m.back),backgroundColor:'#e2e8f0',borderRadius:3}
      ]
    },options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'top',labels:{font:{size:11},padding:8,boxWidth:10}}},scales:{x:{stacked:true,grid:{display:false},ticks:{font:{size:11}}},y:{stacked:true,grid:{color:'#f1f5f9'},ticks:{font:{size:11}}}}}}));

    document.getElementById('member-grid').innerHTML=Object.values(mStats).sort((a,b)=>b.total-a.total).map(m=>{
      const [c1,c2]=avatarGrad(m.name);
      return`<div class="member-card" role="listitem">
        <div class="member-header">
          <div class="member-avatar" style="background:linear-gradient(135deg,${c1},${c2})" aria-hidden="true">${initials(m.name)}</div>
          <div class="member-info"><div class="name">${m.name}</div><div class="em">${m.email}</div></div>
        </div>
        <div class="member-stats-grid">
          <div class="ms done"><div class="v">${m.done}</div><div class="l">Completed</div></div>
          <div class="ms prog"><div class="v">${m.prog}</div><div class="l">In Progress</div></div>
          <div class="ms rev"><div class="v">${m.rev}</div><div class="l">In Review</div></div>
          <div class="ms back"><div class="v">${m.back}</div><div class="l">Backlog</div></div>
        </div>
      </div>`;
    }).join('');
  }catch(err){
    toast('Failed to load ClickUp data. Check your token.','error');
    console.error(err);
  }
}

// ═══════════════════════════════════════════════════════
//  KPI DRILL-DOWN PANEL
// ═══════════════════════════════════════════════════════
const KPI_CONFIG={
  members:{
    title:'Active Team Members',subtitle:'All workspace members and their task breakdown',
    iconBg:'#EEF2FF',iconStroke:'#6366F1',
    icon:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:22px;height:22px"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>'
  },
  completed:{
    title:'Completed Tasks',subtitle:'All tasks marked as done',
    iconBg:'#F0FDF4',iconStroke:'#10B981',
    icon:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:22px;height:22px"><polyline points="20 6 9 17 4 12"/></svg>'
  },
  'in-progress':{
    title:'In Progress',subtitle:'Tasks currently being worked on',
    iconBg:'#F0F9FF',iconStroke:'#0EA5E9',
    icon:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:22px;height:22px"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>'
  },
  review:{
    title:'In Review',subtitle:'Tasks awaiting review or client approval',
    iconBg:'#FFFBEB',iconStroke:'#F59E0B',
    icon:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:22px;height:22px"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>'
  },
  backlog:{
    title:'Backlog',subtitle:'Tasks queued and not yet started',
    iconBg:'#FFF1F2',iconStroke:'#F43F5E',
    icon:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:22px;height:22px"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>'
  }
};

function openKpiPanel(type){
  const cfg=KPI_CONFIG[type];
  if(!cfg)return;
  const icon=document.getElementById('kpi-panel-icon');
  icon.style.background=cfg.iconBg;
  icon.innerHTML=cfg.icon.replace('currentColor',cfg.iconStroke);
  document.getElementById('kpi-panel-title-el').textContent=cfg.title;

  let html='';
  if(type==='members'){
    // Members list
    const memberVals=Object.values(_members);
    if(!memberVals.length){html=emptyPanel('No member data. Connect ClickUp and refresh.')}
    else{
      // Compute per-member task counts from _tasks
      const mStats={};
      memberVals.forEach(m=>{mStats[m.id]={...m,done:0,prog:0,rev:0,back:0,total:0}});
      _tasks.forEach(t=>{
        const s=(t.status?.status||'').toLowerCase();
        (t.assignees||[]).forEach(a=>{
          if(!mStats[a.id])return;
          mStats[a.id].total++;
          if(['completed','done'].includes(s))mStats[a.id].done++;
          else if(s==='in progress')mStats[a.id].prog++;
          else if(['review','under client review'].includes(s))mStats[a.id].rev++;
          else mStats[a.id].back++;
        });
      });
      document.getElementById('kpi-panel-subtitle').textContent=`${memberVals.length} members`;
      html=Object.values(mStats).sort((a,b)=>b.total-a.total).map(m=>{
        const [c1,c2]=avatarGrad(m.name);
        return`<div class="kpi-member-row">
          <div class="kpi-task-av" style="background:linear-gradient(135deg,${c1},${c2})" aria-hidden="true">${initials(m.name)}</div>
          <div class="kpi-task-info"><div class="kpi-task-name">${m.name}</div><div class="kpi-task-meta">${m.email}</div></div>
          <div class="kpi-member-stats">
            <div class="kpi-member-stat"><div class="v" style="color:#10b981">${m.done}</div><div class="l">Done</div></div>
            <div class="kpi-member-stat"><div class="v" style="color:#3b82f6">${m.prog}</div><div class="l">Active</div></div>
            <div class="kpi-member-stat"><div class="v" style="color:#a855f7">${m.rev}</div><div class="l">Review</div></div>
          </div>
        </div>`;
      }).join('');
    }
  } else {
    // Task list filtered by status
    const filtered=_tasks.filter(t=>{
      const s=(t.status?.status||'').toLowerCase();
      if(type==='completed') return['completed','done'].includes(s);
      if(type==='in-progress') return s==='in progress';
      if(type==='review') return['review','under client review'].includes(s);
      if(type==='backlog') return s==='backlog';
      return false;
    });
    document.getElementById('kpi-panel-subtitle').textContent=`${filtered.length} task${filtered.length!==1?'s':''}`;
    if(!filtered.length){html=emptyPanel('No tasks in this category right now.')}
    else{
      html=filtered.map(t=>{
        const as=t.assignees?.[0];
        const [c1,c2]=avatarGrad(as?.username||'?');
        const pName=t.list?.name||t.folder?.name||'';
        return`<div class="kpi-task-row">
          <div class="kpi-task-av" style="background:linear-gradient(135deg,${c1},${c2})" aria-hidden="true">${initials(as?.username||'?')}</div>
          <div class="kpi-task-info">
            <div class="kpi-task-name" title="${t.name}">${clamp(t.name,52)}</div>
            <div class="kpi-task-meta">${[as?.username,pName].filter(Boolean).join(' · ')}</div>
          </div>
        </div>`;
      }).join('');
    }
  }

  document.getElementById('kpi-panel-body').innerHTML=html;
  document.getElementById('panel-overlay').classList.add('open');
  const panel=document.getElementById('kpi-panel');
  panel.classList.add('open');
  panel.removeAttribute('aria-hidden');
  setTimeout(()=>{const f=panel.querySelector('[tabindex="0"],button');if(f)f.focus()},80);
}

function closeKpiPanel(){
  document.getElementById('kpi-panel').classList.remove('open');
  document.getElementById('panel-overlay').classList.remove('open');
  document.getElementById('kpi-panel').setAttribute('aria-hidden','true');
}

function emptyPanel(msg){
  return`<div class="kpi-panel-empty">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <p>${msg}</p>
  </div>`;
}

// ═══════════════════════════════════════════════════════
//  PROJECTS LOG
// ═══════════════════════════════════════════════════════
const P_STATUS={active:'Active','in-progress':'In Progress',review:'Under Review','on-hold':'On Hold',completed:'Completed',cancelled:'Cancelled',closed:'Closed',dismissed:'Dismissed'};
const T_STATUS={backlog:'Backlog','in-progress':'In Progress',review:'In Review','under-client-review':'Under Client Review',completed:'Completed'};

function psBadge(s){const c={active:'badge-active','in-progress':'badge-in-progress',review:'badge-review','on-hold':'badge-on-hold',completed:'badge-completed',cancelled:'badge-cancelled',closed:'badge-closed',dismissed:'badge-dismissed'}[s]||'badge-on-hold';return`<span class="badge ${c}">${P_STATUS[s]||s}</span>`}
function tsBadge(s){const c={backlog:'badge-on-hold','in-progress':'badge-in-progress',review:'badge-review','under-client-review':'badge-in-progress',completed:'badge-completed'}[s]||'badge-on-hold';return`<span class="badge ${c}">${T_STATUS[s]||s}</span>`}
function priBadge(s){return`<span class="badge badge-${s||'medium'}">${(s||'medium').charAt(0).toUpperCase()+(s||'medium').slice(1)}</span>`}

// ── Cloud storage (Firebase Realtime DB) ──────────────────
// Set your Firebase DB URL in Settings → Data Sync once you have one.
// Falls back to localStorage if not configured.
const FB_KEY='d2s_firebase_url'; // stored in localStorage by user
function fbUrl(){return(localStorage.getItem(FB_KEY)||'').replace(/\/$/,'');}
let _projectsCache=null; // in-memory cache so sync feels instant

function getProjects(){
  return _projectsCache!==null?_projectsCache:JSON.parse(localStorage.getItem('d2s_projects')||'[]');
}
function saveAllProjects(arr){
  _projectsCache=arr;
  localStorage.setItem('d2s_projects',JSON.stringify(arr)); // local backup
  const url=fbUrl();
  if(!url)return;
  fetch(url+'/d2s_projects.json',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(arr)})
    .catch(()=>{/* silent – local copy still saved */});
}
async function syncFromCloud(){
  const url=fbUrl();
  if(!url)return;
  try{
    const r=await fetch(url+'/d2s_projects.json');
    if(!r.ok)return;
    const data=await r.json();
    if(Array.isArray(data)&&data.length>0){
      // Firebase has data — it's the source of truth
      _projectsCache=data;
      localStorage.setItem('d2s_projects',JSON.stringify(data));
    } else {
      // Firebase empty — push local data up so the other user can see it
      const local=JSON.parse(localStorage.getItem('d2s_projects')||'[]');
      if(local.length>0){
        fetch(url+'/d2s_projects.json',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(local)}).catch(()=>{});
      }
    }
  }catch(e){/* offline – use local copy */}
}
async function testFirebaseUrl(url){
  try{
    const r=await fetch(url.replace(/\/$/,'')+'/d2s_ping.json',{method:'PUT',headers:{'Content-Type':'application/json'},body:'"ok"'});
    return r.ok;
  }catch{return false;}
}
async function saveFirebaseUrl(){
  const inp=document.getElementById('fb-url-input');
  const st=document.getElementById('fb-status');
  const url=(inp.value||'').trim();
  if(!url){st.style.display='block';st.style.color='#DC2626';st.textContent='Please enter a URL.';return;}
  st.style.display='block';st.style.color='var(--muted)';st.textContent='Testing connection…';
  const ok=await testFirebaseUrl(url);
  if(!ok){st.style.color='#DC2626';st.textContent='Could not connect. Make sure the URL is correct and database rules allow read/write.';return;}
  localStorage.setItem(FB_KEY,url);
  st.style.color='#10B981';st.textContent='✓ Connected! Checking Firebase…';
  // Pull first to see what Firebase already has
  let fbData=null;
  try{
    const r=await fetch(url.replace(/\/$/,'')+'/d2s_projects.json');
    if(r.ok){const d=await r.json();if(Array.isArray(d))fbData=d;}
  }catch(e){}
  const local=JSON.parse(localStorage.getItem('d2s_projects')||'[]');
  if(fbData&&fbData.length>0){
    // Firebase already has data — it wins (merge scenario: take Firebase)
    _projectsCache=fbData;
    localStorage.setItem('d2s_projects',JSON.stringify(fbData));
    st.textContent=`✓ Connected — pulled ${fbData.length} projects from Firebase`;
    toast(`Firebase connected — ${fbData.length} projects synced from cloud!`,'success');
  } else if(local.length>0){
    // Firebase is empty but we have local projects — push them up
    await fetch(url.replace(/\/$/,'')+'/d2s_projects.json',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(local)});
    _projectsCache=local;
    st.textContent=`✓ Connected — uploaded ${local.length} local projects to Firebase`;
    toast(`Firebase connected — ${local.length} projects uploaded to cloud!`,'success');
  } else {
    st.textContent='✓ Connected — both local and Firebase are empty';
    toast('Firebase connected!','success');
  }
  renderProjects();
}
function clearFirebaseUrl(){
  localStorage.removeItem(FB_KEY);
  const st=document.getElementById('fb-status');
  if(st){st.style.display='block';st.style.color='var(--muted)';st.textContent='Disconnected. Projects will be stored locally only.';}
  const inp=document.getElementById('fb-url-input');
  if(inp)inp.value='';
  toast('Firebase disconnected');
}
function initFirebaseSettings(){
  const inp=document.getElementById('fb-url-input');
  const st=document.getElementById('fb-status');
  if(!inp)return;
  const url=fbUrl();
  if(url){
    inp.value=url;
    if(st){st.style.display='block';st.style.color='#10B981';st.textContent='✓ Connected to Firebase';}
  }
}

function chipsHtml(items,style,max=2){
  if(!items||!items.length)return'<span style="color:var(--muted);font-size:12px">—</span>';
  const shown=items.slice(0,max);
  const extra=items.length-max;
  return shown.map(t=>`<span class="chip" style="${style}">${t}</span>`).join('')+
    (extra>0?`<span class="chip" style="background:#E5E7EB;color:#6B7280;font-weight:600;font-size:11px" title="${items.slice(max).join(', ')}">+${extra}</span>`:'');
}
let _sortCol='',_sortDir='asc';
function setSort(col){
  if(_sortCol===col){_sortDir=_sortDir==='asc'?'desc':'asc';}
  else{_sortCol=col;_sortDir='asc';}
  renderProjects();
}
const PRIORITY_ORDER={high:0,medium:1,low:2};
function renderProjects(){
  const projects=getProjects();
  const fSt=document.getElementById('filter-status').value;
  const fPr=document.getElementById('filter-priority').value;
  const fQ=(document.getElementById('filter-search').value||'').toLowerCase();
  let filtered=projects.filter(p=>{
    if(fSt&&p.projectStatus!==fSt)return false;
    if(fPr&&p.priority!==fPr)return false;
    if(fQ&&!p.name.toLowerCase().includes(fQ)&&!(p.client||'').toLowerCase().includes(fQ)&&!(p.notes||'').toLowerCase().includes(fQ))return false;
    return true;
  });
  // Sort
  if(_sortCol){
    filtered=[...filtered].sort((a,b)=>{
      let av=a[_sortCol]||'',bv=b[_sortCol]||'';
      if(_sortCol==='priority'){av=PRIORITY_ORDER[av]??99;bv=PRIORITY_ORDER[bv]??99;return _sortDir==='asc'?av-bv:bv-av;}
      if(_sortCol==='startDate'||_sortCol==='dueDate'){av=av||'9999';bv=bv||'9999';}
      return _sortDir==='asc'?String(av).localeCompare(String(bv)):String(bv).localeCompare(String(av));
    });
  }
  // Update sort icons
  ['name','projectStatus','taskStatus','priority','startDate','dueDate'].forEach(col=>{
    const th=document.getElementById('th-'+col);
    const si=document.getElementById('si-'+col);
    if(!th||!si)return;
    th.classList.toggle('sort-active',_sortCol===col);
    si.className='sort-icon'+(_sortCol===col?' '+_sortDir:'');
  });
  // Project count
  const total=projects.length;
  const countEl=document.getElementById('proj-count');
  if(countEl)countEl.textContent=filtered.length===total?`${total} project${total!==1?'s':''}`:
    `${filtered.length} of ${total} project${total!==1?'s':''}`;
  const today=new Date();today.setHours(0,0,0,0);
  const tbody=document.getElementById('projects-tbody');
  document.getElementById('projects-empty').classList.toggle('hidden',filtered.length>0);
  tbody.innerHTML=filtered.map((p,i)=>{
    const isOverdue=p.dueDate&&new Date(p.dueDate)<today&&p.projectStatus!=='completed'&&p.projectStatus!=='cancelled';
    return `
    <tr class="proj-row" onclick="openProjectDetail('${p.id}')" tabindex="0" onkeydown="if(event.key==='Enter')openProjectDetail('${p.id}')">
      <td class="cb-col" onclick="event.stopPropagation()"><input type="checkbox" class="proj-cb row-cb" data-id="${p.id}" onchange="onRowCbChange()" aria-label="Select ${p.name}"/></td>
      <td class="num-col">${i+1}</td>
      <td><div class="proj-name">${p.name}</div>${p.client?`<div style="font-size:11px;color:var(--muted)">${p.client}</div>`:''}</td>
      <td>${psBadge(p.projectStatus||'active')}</td>
      <td>${tsBadge(p.taskStatus||'backlog')}</td>
      <td>${priBadge(p.priority)}</td>
      <td style="white-space:nowrap">${fmtDate(p.startDate)||'—'}</td>
      <td style="white-space:nowrap">${fmtDate(p.dueDate)||'—'}${isOverdue?'<span class="overdue-chip" title="Past due date">Overdue</span>':''}</td>
      <td><div class="chip-group" style="margin-top:0;flex-wrap:nowrap">${chipsHtml(p.projectTypes,'background:#F0F9FF;color:#0369A1;border:1px solid #BAE6FD')}</div></td>
      <td><div class="chip-group" style="margin-top:0;flex-wrap:nowrap">${chipsHtml(p.assignees,'background:#F3F4F6;color:#374151')}</div></td>
      <td><div class="proj-notes-cell" title="${(p.notes||'').replace(/"/g,'&quot;')}">${p.notes||'—'}</div></td>
      <td onclick="event.stopPropagation()">
        <div style="display:flex;gap:4px">
          <button class="btn-icon" onclick="editProject('${p.id}')" aria-label="Edit ${p.name}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          </button>
          <button class="btn-icon danger" onclick="deleteProject('${p.id}')" aria-label="Delete ${p.name}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 011-1h4a1 1 0 011 1v2"/></svg>
          </button>
        </div>
      </td>
    </tr>`;}).join('');
}

// ── Draft auto-save for project modal ──────────────────────────
const DRAFT_KEY='d2s_project_draft';
function saveDraft(){
  // Only save draft for NEW projects (no id set)
  if(document.getElementById('pm-id').value)return;
  const draft={
    name:document.getElementById('pm-name').value,
    projectStatus:document.getElementById('pm-proj-status').value,
    taskStatus:document.getElementById('pm-task-status').value,
    priority:document.getElementById('pm-priority').value,
    client:document.getElementById('pm-client').value,
    startDate:document.getElementById('pm-start').value,
    dueDate:document.getElementById('pm-due').value,
    notes:document.getElementById('pm-notes').value,
    projectTypes:[..._tmpProjectTypes],
    assignees:[..._tmpAssignees],
    savedAt:new Date().toISOString()
  };
  localStorage.setItem(DRAFT_KEY,JSON.stringify(draft));
  // Show "Draft saved" badge in modal title
  let badge=document.getElementById('pm-draft-badge');
  if(!badge){
    badge=document.createElement('span');badge.id='pm-draft-badge';badge.className='draft-badge';badge.textContent='Draft saved';
    document.getElementById('project-modal-title').appendChild(badge);
  }
}
function clearDraft(){
  localStorage.removeItem(DRAFT_KEY);
  const b=document.getElementById('pm-draft-badge');if(b)b.remove();
}
function restoreDraft(){
  const draft=JSON.parse(localStorage.getItem(DRAFT_KEY)||'null');
  if(!draft||!draft.name)return false;
  // Restore all fields
  document.getElementById('pm-name').value=draft.name||'';
  document.getElementById('pm-proj-status').value=draft.projectStatus||'active';
  document.getElementById('pm-task-status').value=draft.taskStatus||'backlog';
  document.getElementById('pm-priority').value=draft.priority||'medium';
  document.getElementById('pm-client').value=draft.client||'';
  document.getElementById('pm-start').value=draft.startDate||'';
  document.getElementById('pm-due').value=draft.dueDate||'';
  document.getElementById('pm-notes').value=draft.notes||'';
  _tmpAssignees=[...(draft.assignees||[])];
  _tmpProjectTypes=[...(draft.projectTypes||[])];
  renderChips();renderTypeChips();
  // Show badge
  let badge=document.getElementById('pm-draft-badge');
  if(!badge){
    badge=document.createElement('span');badge.id='pm-draft-badge';badge.className='draft-badge';
    document.getElementById('project-modal-title').appendChild(badge);
  }
  const ago=draft.savedAt?timeSince(new Date(draft.savedAt)):'';
  badge.textContent='Draft restored'+(ago?' · '+ago:'');
  return true;
}
function timeSince(date){
  const s=Math.floor((new Date()-date)/1000);
  if(s<60)return'just now';
  if(s<3600)return Math.floor(s/60)+'m ago';
  if(s<86400)return Math.floor(s/3600)+'h ago';
  return Math.floor(s/86400)+'d ago';
}

function openAddProject(){
  document.getElementById('project-modal-title').textContent='Add Project';
  document.getElementById('pm-id').value='';
  // Clear old badge
  const b=document.getElementById('pm-draft-badge');if(b)b.remove();
  // Try to restore draft first, otherwise reset fields
  const hasDraft=restoreDraft();
  if(!hasDraft){
    ['pm-name','pm-client','pm-notes'].forEach(id=>document.getElementById(id).value='');
    document.getElementById('pm-proj-status').value='active';
    document.getElementById('pm-task-status').value='backlog';
    document.getElementById('pm-priority').value='medium';
    document.getElementById('pm-start').value='';
    document.getElementById('pm-due').value='';
    _tmpAssignees=[];
    _tmpProjectTypes=[];
    renderChips();
    renderTypeChips();
  }
  hideErr('pm-err');
  openModal('project-modal');
}

function editProject(id){
  const p=getProjects().find(x=>String(x.id)===String(id));if(!p)return;
  document.getElementById('project-modal-title').textContent='Edit Project';
  document.getElementById('pm-id').value=p.id;
  document.getElementById('pm-name').value=p.name;
  document.getElementById('pm-proj-status').value=p.projectStatus||'active';
  document.getElementById('pm-task-status').value=p.taskStatus||'backlog';
  document.getElementById('pm-priority').value=p.priority||'medium';
  document.getElementById('pm-client').value=p.client||'';
  document.getElementById('pm-start').value=p.startDate||'';
  document.getElementById('pm-due').value=p.dueDate||'';
  document.getElementById('pm-notes').value=p.notes||'';
  hideErr('pm-err');
  _tmpAssignees=[...(p.assignees||[])];
  _tmpProjectTypes=[...(p.projectTypes||[])];
  renderChips();
  renderTypeChips();
  openModal('project-modal');
}

function saveProject(){
  const name=document.getElementById('pm-name').value.trim();
  if(!name){showErr('pm-err','Project name is required.');return}
  hideErr('pm-err');
  const projects=getProjects();
  const id=document.getElementById('pm-id').value;
  const data={
    id:id||uuid(),name,
    projectStatus:document.getElementById('pm-proj-status').value,
    taskStatus:document.getElementById('pm-task-status').value,
    priority:document.getElementById('pm-priority').value,
    client:document.getElementById('pm-client').value.trim(),
    startDate:document.getElementById('pm-start').value,
    dueDate:document.getElementById('pm-due').value,
    projectTypes:[..._tmpProjectTypes],
    assignees:[..._tmpAssignees],
    notes:document.getElementById('pm-notes').value.trim(),
    updatedAt:new Date().toISOString(),
    createdAt:id?(projects.find(p=>p.id===id)?.createdAt||new Date().toISOString()):new Date().toISOString(),
    createdBy:localStorage.getItem('d2s_session')||''
  };
  if(id){const i=projects.findIndex(p=>String(p.id)===String(id));i>-1?projects[i]=data:projects.push(data)}
  else projects.unshift(data);
  saveAllProjects(projects);
  clearDraft();
  closeModal('project-modal');
  renderProjects();
  toast(id?'Project updated!':'Project added!','success');
}

function deleteProject(id){
  if(!confirm('Delete this project? This cannot be undone.'))return;
  saveAllProjects(getProjects().filter(p=>String(p.id)!==String(id)));
  closeProjectDetail();
  renderProjects();
  toast('Project deleted');
}

function addAssignee(){
  const inp=document.getElementById('pm-assignee-input');
  const v=inp.value.trim();
  if(!v)return;
  if(!_tmpAssignees.includes(v))_tmpAssignees.push(v);
  inp.value='';
  renderChips();saveDraft();
}
function removeAssignee(n){_tmpAssignees=_tmpAssignees.filter(a=>a!==n);renderChips();saveDraft();}
function renderChips(){
  document.getElementById('pm-assignees').innerHTML=_tmpAssignees.map(a=>`<span class="chip">${a}<span class="rm" onclick="removeAssignee('${a.replace(/'/g,"\\'")}')" role="button" aria-label="Remove ${a}" tabindex="0" onkeydown="if(event.key==='Enter')removeAssignee('${a.replace(/'/g,"\\'")}')">×</span></span>`).join('');
}

function addProjectType(){
  const inp=document.getElementById('pm-type-input');
  const v=inp.value.trim();
  if(!v)return;
  if(!_tmpProjectTypes.includes(v))_tmpProjectTypes.push(v);
  inp.value='';
  renderTypeChips();saveDraft();
}
function removeProjectType(t){_tmpProjectTypes=_tmpProjectTypes.filter(x=>x!==t);renderTypeChips();saveDraft();}
function renderTypeChips(){
  document.getElementById('pm-types').innerHTML=_tmpProjectTypes.map(t=>`<span class="chip" style="background:#F0F9FF;color:#0369A1;border:1px solid #BAE6FD">${t}<span class="rm" onclick="removeProjectType('${t.replace(/'/g,"\\'")}')" role="button" aria-label="Remove ${t}" tabindex="0" onkeydown="if(event.key==='Enter')removeProjectType('${t.replace(/'/g,"\\'")}')">×</span></span>`).join('');
}

function exportProjects(){
  const blob=new Blob([JSON.stringify(getProjects(),null,2)],{type:'application/json'});
  const a=document.createElement('a');
  a.href=URL.createObjectURL(blob);
  a.download='dot2shape-projects-'+new Date().toISOString().slice(0,10)+'.json';
  a.click();
}
function importProjects(e){
  const file=e.target.files[0];if(!file)return;
  const r=new FileReader();
  r.onload=ev=>{
    try{const d=JSON.parse(ev.target.result);saveAllProjects(d);renderProjects();toast(`Imported ${d.length} projects!`,'success');}
    catch{toast('Invalid JSON file','error');}
  };
  r.readAsText(file);
  e.target.value='';
}

// ═══════════════════════════════════════════════════════
//  WEEKLY STATUS REPORTS
// ═══════════════════════════════════════════════════════
let _reportsCache=null;
function getReports(){
  return _reportsCache!==null?_reportsCache:JSON.parse(localStorage.getItem('d2s_reports')||'[]');
}
function saveAllReports(arr){
  _reportsCache=arr;
  localStorage.setItem('d2s_reports',JSON.stringify(arr));
  const url=fbUrl();
  if(!url)return;
  fetch(url+'/d2s_reports.json',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(arr)})
    .catch(()=>{});
}
async function syncReportsFromCloud(){
  const url=fbUrl();
  if(!url)return;
  try{
    const r=await fetch(url+'/d2s_reports.json');
    if(!r.ok)return;
    const data=await r.json();
    if(Array.isArray(data)&&data.length>0){
      _reportsCache=data;
      localStorage.setItem('d2s_reports',JSON.stringify(data));
    } else {
      const local=JSON.parse(localStorage.getItem('d2s_reports')||'[]');
      if(local.length>0){
        fetch(url+'/d2s_reports.json',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(local)}).catch(()=>{});
      }
    }
  }catch(e){}
}

// (fetchReportById inlined into checkPublicReportUrl below)
// placeholder kept for reference only
async function fetchReportById(id){return null;
}

function renderReports(){
  const reports=getReports().sort((a,b)=>new Date(b.weekStart||b.createdAt)-new Date(a.weekStart||a.createdAt));
  const grid=document.getElementById('reports-grid');
  const empty=document.getElementById('reports-empty');
  if(!grid)return;
  if(!reports.length){grid.innerHTML='';empty.style.display='block';return;}
  empty.style.display='none';
  grid.innerHTML=reports.map(r=>{
    const weekLabel=r.weekStart&&r.weekEnd?`${fmtDate(r.weekStart)} – ${fmtDate(r.weekEnd)}`:(r.weekStart?fmtDate(r.weekStart):'No dates set');
    const preview=r.content?(new DOMParser().parseFromString(r.content,'text/html').body.textContent||'').slice(0,160):'';
    return `<div class="report-card" onclick="openEditReport('${r.id}')">
      <div class="report-card-head">
        <div class="report-card-week">Week of ${weekLabel}</div>
        <div class="report-card-meta">By ${r.createdBy||'team'} · ${fmtDate(r.updatedAt||r.createdAt)}</div>
      </div>
      <div class="report-card-body">${r.content||'<em style="color:#9CA3AF">No content yet</em>'}</div>
      <div class="report-card-foot">
        <button class="btn btn-secondary btn-sm" onclick="event.stopPropagation();shareReport('${r.id}')" title="Copy shareable link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:13px;height:13px" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
          Share
        </button>
        <button class="btn btn-secondary btn-sm" onclick="event.stopPropagation();openEditReport('${r.id}')" title="Edit report">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:13px;height:13px" aria-hidden="true"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          Edit
        </button>
        <button class="btn btn-sm" onclick="event.stopPropagation();deleteReport('${r.id}')" style="background:#FEF2F2;color:#DC2626;border:1px solid #FECACA" title="Delete">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:13px;height:13px" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/></svg>
        </button>
      </div>
    </div>`;
  }).join('');
}

function openNewReport(){
  document.getElementById('report-modal-title').textContent='New Weekly Status Report';
  document.getElementById('rm-id').value='';
  document.getElementById('rm-start').value='';
  document.getElementById('rm-end').value='';
  document.getElementById('rm-editor').innerHTML='';
  document.getElementById('rm-err').textContent='';
  document.getElementById('rm-err').classList.remove('show');
  // Default to current week (Mon–Sun)
  const today=new Date();
  const day=today.getDay();
  const mon=new Date(today);mon.setDate(today.getDate()-(day===0?6:day-1));
  const sun=new Date(mon);sun.setDate(mon.getDate()+6);
  document.getElementById('rm-start').value=mon.toISOString().slice(0,10);
  document.getElementById('rm-end').value=sun.toISOString().slice(0,10);
  openModal('report-modal');
  setTimeout(()=>document.getElementById('rm-editor').focus(),80);
}

function openEditReport(id){
  const r=getReports().find(x=>x.id===id);if(!r)return;
  document.getElementById('report-modal-title').textContent='Edit Weekly Report';
  document.getElementById('rm-id').value=r.id;
  document.getElementById('rm-start').value=r.weekStart||'';
  document.getElementById('rm-end').value=r.weekEnd||'';
  document.getElementById('rm-editor').innerHTML=r.content||'';
  document.getElementById('rm-err').textContent='';
  document.getElementById('rm-err').classList.remove('show');
  openModal('report-modal');
}

function updateReportTitle(){
  const s=document.getElementById('rm-start').value;
  const e=document.getElementById('rm-end').value;
  if(s&&e)document.getElementById('report-modal-title').textContent=`Week of ${fmtDate(s)} – ${fmtDate(e)}`;
}

function saveReport(){
  const id=document.getElementById('rm-id').value;
  const weekStart=document.getElementById('rm-start').value;
  const weekEnd=document.getElementById('rm-end').value;
  const content=document.getElementById('rm-editor').innerHTML.trim();
  const errEl=document.getElementById('rm-err');
  if(!weekStart||!weekEnd){errEl.textContent='Please set the week start and end dates.';errEl.classList.add('show');return;}
  errEl.classList.remove('show');
  const reports=getReports();
  const now=new Date().toISOString();
  const email=localStorage.getItem('d2s_session')||'team';
  const data={
    id:id||uuid(),
    weekStart,weekEnd,content,
    updatedAt:now,
    createdAt:id?(reports.find(r=>r.id===id)?.createdAt||now):now,
    createdBy:email
  };
  if(id){const i=reports.findIndex(r=>r.id===id);i>-1?reports[i]=data:reports.unshift(data);}
  else reports.unshift(data);
  saveAllReports(reports);
  closeModal('report-modal');
  renderReports();
  toast(id?'Report updated!':'Report saved!','success');
}

function deleteReport(id){
  if(!confirm('Delete this weekly report? This cannot be undone.'))return;
  saveAllReports(getReports().filter(r=>r.id!==id));
  renderReports();
  toast('Report deleted');
}

function shareReport(id){
  const base=location.href.split('#')[0].split('?')[0];
  const url=fbUrl();
  // Include Firebase URL in the link so external viewers can fetch the data
  let link=base+'?report='+id;
  if(url)link+='&fb='+encodeURIComponent(url);
  navigator.clipboard.writeText(link).then(()=>toast('Public link copied! Share with anyone — no login required.','success')).catch(()=>{
    prompt('Copy this link:',link);
  });
}

// ── Rich text editor command ──
function rteCmd(cmd){
  document.getElementById('rm-editor').focus();
  document.execCommand(cmd,false,null);
}

// ── Public report view (no auth required) ──
function showPublicReport(report){
  const weekLabel=report.weekStart&&report.weekEnd?`${fmtDate(report.weekStart)} – ${fmtDate(report.weekEnd)}`:(report.weekStart?fmtDate(report.weekStart):'');
  document.getElementById('pub-report-title').textContent=weekLabel?`Week of ${weekLabel}`:'Weekly Status Report';
  document.getElementById('pub-report-week').textContent=`Prepared by ${report.createdBy||'Dot2Shape team'} · Updated ${fmtDate(report.updatedAt||report.createdAt)}`;
  document.getElementById('pub-report-body').innerHTML=report.content||'<em style="color:#9CA3AF">No content available.</em>';
  document.getElementById('public-report-overlay').classList.add('open');
  document.body.style.overflow='hidden';
}

async function checkPublicReportUrl(){
  const params=new URLSearchParams(window.location.search);
  const reportId=params.get('report');
  if(!reportId)return false;
  // Show loading state immediately
  document.getElementById('public-report-overlay').classList.add('open');
  document.getElementById('pub-report-body').innerHTML='<p style="color:var(--muted);text-align:center;padding:40px 0">Loading report…</p>';
  document.getElementById('pub-report-title').textContent='Weekly Status Report';
  document.getElementById('pub-report-week').textContent='';
  let report=null;
  // 1. Try Firebase URL embedded in the share link (?fb=...)
  const fbFromUrl=params.get('fb');
  const urlsToTry=[fbFromUrl,fbUrl()].filter(Boolean);
  for(const url of urlsToTry){
    if(report)break;
    try{
      const r=await fetch(url.replace(/\/$/,'')+'/d2s_reports.json');
      if(r.ok){
        const data=await r.json();
        if(Array.isArray(data)){
          report=data.find(x=>x.id===reportId)||null;
          // Cache this Firebase URL for future use
          if(report&&fbFromUrl)localStorage.setItem(FB_KEY,fbFromUrl.replace(/\/$/,''));
        }
      }
    }catch(e){}
  }
  // 2. Fallback: localStorage
  if(!report){
    const local=JSON.parse(localStorage.getItem('d2s_reports')||'[]');
    report=local.find(r=>r.id===reportId)||null;
  }
  if(report){
    showPublicReport(report);
  }else{
    document.getElementById('pub-report-body').innerHTML='<p style="color:#DC2626;text-align:center;padding:40px 0">⚠️ Report not found. The link may have expired or the report was deleted.</p>';
  }
  return true;
}

// ── JS sticky table header ──────────────────────────────────
// CSS position:sticky can't work here because overflow-x:auto on the wrapper
// forces a Y scroll container, making top:Xpx act as a static offset instead.
// We use translateY on the thead so it sticks visually while column widths stay aligned.
function initStickyHeader(){
  const mc=document.querySelector('.main-content');
  if(!mc)return;
  // Remove any previous listener to avoid duplicates
  if(mc._stickyHandler)mc.removeEventListener('scroll',mc._stickyHandler);
  mc._stickyHandler=onStickyScroll;
  mc.addEventListener('scroll',mc._stickyHandler,{passive:true});
  onStickyScroll(); // run immediately in case page already scrolled
}
function onStickyScroll(){
  const page=document.getElementById('page-projects');
  if(!page||!page.classList.contains('active'))return;
  const wrap=page.querySelector('.proj-table-wrap');
  const thead=page.querySelector('.proj-table thead');
  if(!wrap||!thead)return;
  const tb=page.querySelector('.topbar');
  const fr=page.querySelector('.filter-row');
  const stickyY=(tb?tb.offsetHeight:52)+(fr&&fr.offsetHeight>20?fr.offsetHeight:54);
  const wrapRect=wrap.getBoundingClientRect();
  const diff=stickyY-wrapRect.top;
  const maxShift=wrap.offsetHeight-thead.offsetHeight;
  if(diff>0&&diff<maxShift){
    thead.style.transform=`translateY(${diff}px)`;
    thead.style.boxShadow='0 2px 6px rgba(0,0,0,.07)';
  }else{
    thead.style.transform='';
    thead.style.boxShadow='';
  }
}

// ── Multi-select / bulk actions ──
function getSelectedIds(){
  return [...document.querySelectorAll('.row-cb:checked')].map(cb=>cb.dataset.id);
}
function onRowCbChange(){
  const all=document.querySelectorAll('.row-cb');
  const checked=document.querySelectorAll('.row-cb:checked');
  const selectAll=document.getElementById('cb-select-all');
  if(selectAll){
    selectAll.indeterminate=checked.length>0&&checked.length<all.length;
    selectAll.checked=checked.length===all.length&&all.length>0;
  }
  updateBulkBar();
}
function toggleSelectAll(cb){
  document.querySelectorAll('.row-cb').forEach(r=>r.checked=cb.checked);
  updateBulkBar();
}
function clearSelection(){
  document.querySelectorAll('.row-cb').forEach(r=>r.checked=false);
  const sa=document.getElementById('cb-select-all');
  if(sa){sa.checked=false;sa.indeterminate=false;}
  updateBulkBar();
}
function updateBulkBar(){
  const ids=getSelectedIds();
  const bar=document.getElementById('bulk-bar');
  document.getElementById('bulk-count').textContent=ids.length;
  bar.classList.toggle('visible',ids.length>0);
}
function getSelectedProjects(){
  const ids=getSelectedIds();
  return getProjects().filter(p=>ids.includes(String(p.id)));
}
function bulkDelete(){
  const ids=getSelectedIds();
  if(!ids.length)return;
  if(!confirm(`Delete ${ids.length} selected project${ids.length!==1?'s':''}? This cannot be undone.`))return;
  saveAllProjects(getProjects().filter(p=>!ids.includes(String(p.id))));
  clearSelection();
  renderProjects();
  toast(`Deleted ${ids.length} project${ids.length!==1?'s':''}`, 'success');
}
function bulkExportCSV(){
  const sel=getSelectedProjects();
  if(!sel.length)return;
  const cols=['name','projectStatus','taskStatus','priority','client','projectTypes','startDate','dueDate','assignees','notes'];
  const headers=['Project Name','Project Status','Task Status','Priority','Client','Project Type','Start Date','Due Date','Assigned To','Notes'];
  const rows=sel.map(p=>cols.map(c=>{
    const v=p[c];
    if(Array.isArray(v))return '"'+v.join(', ')+'"';
    if(v==null)return '';
    return '"'+String(v).replace(/"/g,'""')+'"';
  }).join(','));
  const csv=[headers.map(h=>'"'+h+'"').join(','),...rows].join('\r\n');
  const blob=new Blob([csv],{type:'text/csv'});
  const a=document.createElement('a');
  a.href=URL.createObjectURL(blob);
  a.download='dot2shape-selected-'+new Date().toISOString().slice(0,10)+'.csv';
  a.click();
}
function bulkExportXLSX(){
  if(typeof XLSX==='undefined'){toast('Excel library not loaded yet, try again','error');return;}
  const sel=getSelectedProjects();
  if(!sel.length)return;
  const cols=['name','projectStatus','taskStatus','priority','client','projectTypes','startDate','dueDate','assignees','notes'];
  const headers=['Project Name','Project Status','Task Status','Priority','Client','Project Type','Start Date','Due Date','Assigned To','Notes'];
  const data=[headers,...sel.map(p=>cols.map(c=>{
    const v=p[c];
    if(Array.isArray(v))return v.join(', ');
    return v||'';
  }))];
  const ws=XLSX.utils.aoa_to_sheet(data);
  ws['!cols']=headers.map(()=>({wch:20}));
  const wb=XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb,ws,'Projects');
  XLSX.writeFile(wb,'dot2shape-selected-'+new Date().toISOString().slice(0,10)+'.xlsx');
}

// ── Project Detail Panel ──
function openProjectDetail(id){
  const p=getProjects().find(x=>String(x.id)===String(id));
  if(!p)return;
  document.getElementById('proj-detail-title').textContent=p.name;
  document.getElementById('proj-detail-edit-btn').onclick=()=>{closeProjectDetail();editProject(id);};
  document.getElementById('proj-detail-delete-btn').onclick=()=>deleteProject(id);

  const typeChips=(p.projectTypes||[]).map(t=>`<span class="chip" style="background:#F0F9FF;color:#0369A1;border:1px solid #BAE6FD">${t}</span>`).join('')||'<span style="color:var(--muted);font-size:13px">—</span>';
  const assigneeChips=(p.assignees||[]).map(a=>`<span class="chip" style="background:#F3F4F6;color:#374151">${a}</span>`).join('')||'<span style="color:var(--muted);font-size:13px">—</span>';

  document.getElementById('proj-detail-body').innerHTML=`
    <div class="proj-detail-grid">
      <div class="proj-detail-section">
        <div class="proj-detail-label">Project Status</div>
        <div>${psBadge(p.projectStatus||'active')}</div>
      </div>
      <div class="proj-detail-section">
        <div class="proj-detail-label">Task Status</div>
        <div>${tsBadge(p.taskStatus||'backlog')}</div>
      </div>
      <div class="proj-detail-section">
        <div class="proj-detail-label">Priority</div>
        <div>${priBadge(p.priority)}</div>
      </div>
    </div>
    <div class="proj-detail-grid">
      <div class="proj-detail-section">
        <div class="proj-detail-label">Client</div>
        <div class="proj-detail-value">${p.client||'—'}</div>
      </div>
      <div class="proj-detail-section">
        <div class="proj-detail-label">Start Date</div>
        <div class="proj-detail-value">${fmtDate(p.startDate)||'—'}</div>
      </div>
      <div class="proj-detail-section">
        <div class="proj-detail-label">Due Date</div>
        <div class="proj-detail-value">${fmtDate(p.dueDate)||'—'}</div>
      </div>
    </div>
    <div class="proj-detail-section">
      <div class="proj-detail-label">Project Type</div>
      <div class="chip-group" style="margin-top:4px">${typeChips}</div>
    </div>
    <div class="proj-detail-section">
      <div class="proj-detail-label">Assigned To</div>
      <div class="chip-group" style="margin-top:4px">${assigneeChips}</div>
    </div>
    ${p.notes?`<div class="proj-detail-section">
      <div class="proj-detail-label">Notes</div>
      <div class="proj-detail-value" style="white-space:pre-wrap;line-height:1.6;background:#F9FAFB;border-radius:8px;padding:12px;font-size:13px">${p.notes}</div>
    </div>`:''}
    <div class="proj-detail-section" style="margin-top:auto;padding-top:4px">
      <div class="proj-detail-label">Last Updated</div>
      <div class="proj-detail-value" style="font-size:12px;color:var(--muted)">${p.updatedAt?new Date(p.updatedAt).toLocaleString():new Date(p.createdAt||Date.now()).toLocaleString()}</div>
    </div>`;

  document.getElementById('proj-panel-overlay').classList.add('open');
  const panel=document.getElementById('proj-panel');
  panel.classList.add('open');
  panel.removeAttribute('aria-hidden');
  panel.querySelector('button').focus();
}
function closeProjectDetail(){
  document.getElementById('proj-panel').classList.remove('open');
  document.getElementById('proj-panel-overlay').classList.remove('open');
  document.getElementById('proj-panel').setAttribute('aria-hidden','true');
}

// ── Dropdown helpers ──
function toggleDropdown(id){
  const menu=document.getElementById(id);
  const wasOpen=menu.classList.contains('open');
  closeDropdowns();
  if(!wasOpen){menu.classList.add('open');}
}
function closeDropdowns(){
  document.querySelectorAll('.dropdown-menu.open').forEach(m=>m.classList.remove('open'));
}
document.addEventListener('click',function(e){
  if(!e.target.closest('.dropdown-wrap'))closeDropdowns();
});

// ── Export: CSV ──
function exportCSV(){
  const cols=['name','projectStatus','taskStatus','priority','client','projectTypes','startDate','dueDate','assignees','notes'];
  const headers=['Project Name','Project Status','Task Status','Priority','Client','Project Type','Start Date','Due Date','Assigned To','Notes'];
  const rows=getProjects().map(p=>cols.map(c=>{
    const v=p[c];
    if(Array.isArray(v))return '"'+v.join(', ')+'"';
    if(v==null)return '';
    return '"'+String(v).replace(/"/g,'""')+'"';
  }).join(','));
  const csv=[headers.map(h=>'"'+h+'"').join(','),...rows].join('\r\n');
  const blob=new Blob([csv],{type:'text/csv'});
  const a=document.createElement('a');
  a.href=URL.createObjectURL(blob);
  a.download='dot2shape-projects-'+new Date().toISOString().slice(0,10)+'.csv';
  a.click();
}

// ── Export: Excel ──
function exportXLSX(){
  if(typeof XLSX==='undefined'){toast('Excel library not loaded yet, try again','error');return;}
  const cols=['name','projectStatus','taskStatus','priority','client','projectTypes','startDate','dueDate','assignees','notes'];
  const headers=['Project Name','Project Status','Task Status','Priority','Client','Project Type','Start Date','Due Date','Assigned To','Notes'];
  const data=[headers,...getProjects().map(p=>cols.map(c=>{
    const v=p[c];
    if(Array.isArray(v))return v.join(', ');
    return v||'';
  }))];
  const ws=XLSX.utils.aoa_to_sheet(data);
  ws['!cols']=headers.map(()=>({wch:20}));
  const wb=XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb,ws,'Projects');
  XLSX.writeFile(wb,'dot2shape-projects-'+new Date().toISOString().slice(0,10)+'.xlsx');
}

// ── Import: CSV ──
function importCSV(e){
  const file=e.target.files[0];if(!file)return;
  const r=new FileReader();
  r.onload=ev=>{
    try{
      const lines=ev.target.result.split(/\r?\n/).filter(l=>l.trim());
      if(lines.length<2){toast('CSV has no data rows','error');return;}
      const headers=parseCSVRow(lines[0]).map(h=>h.trim().toLowerCase());
      const colMap={
        'project name':'name','name':'name',
        'project status':'projectStatus','task status':'taskStatus',
        'priority':'priority','client':'client',
        'project type':'projectTypes','projecttype':'projectTypes',
        'start date':'startDate','due date':'dueDate',
        'assigned to':'assignees','notes':'notes'
      };
      const imported=lines.slice(1).map((line,i)=>{
        const vals=parseCSVRow(line);
        const proj={id:uuid(),createdAt:new Date().toISOString(),createdBy:localStorage.getItem('d2s_session')||'import'};
        headers.forEach((h,idx)=>{
          const key=colMap[h];
          if(!key)return;
          const v=vals[idx]||'';
          if(key==='projectTypes'||key==='assignees')proj[key]=v?v.split(',').map(s=>s.trim()).filter(Boolean):[];
          else proj[key]=v;
        });
        return proj;
      }).filter(p=>p.name);
      const existing=getProjects();
      saveAllProjects([...existing,...imported]);
      renderProjects();
      toast(`Imported ${imported.length} project${imported.length!==1?'s':''}!`,'success');
    }catch(err){toast('Failed to parse CSV: '+err.message,'error');}
  };
  r.readAsText(file);
  e.target.value='';
}
function parseCSVRow(row){
  const res=[];let cur='';let inQ=false;
  for(let i=0;i<row.length;i++){
    if(row[i]==='"'){if(inQ&&row[i+1]==='"'){cur+='"';i++;}else{inQ=!inQ;}}
    else if(row[i]===','&&!inQ){res.push(cur);cur='';}
    else cur+=row[i];
  }
  res.push(cur);
  return res;
}

// ── Import: Excel ──
function importXLSX(e){
  const file=e.target.files[0];if(!file)return;
  if(typeof XLSX==='undefined'){toast('Excel library not loaded yet, try again','error');return;}
  const r=new FileReader();
  r.onload=ev=>{
    try{
      const wb=XLSX.read(ev.target.result,{type:'array'});
      const ws=wb.Sheets[wb.SheetNames[0]];
      const rows=XLSX.utils.sheet_to_json(ws,{header:1,defval:''});
      if(rows.length<2){toast('Excel has no data rows','error');return;}
      const headers=rows[0].map(h=>String(h).trim().toLowerCase());
      const colMap={
        'project name':'name','name':'name',
        'project status':'projectStatus','task status':'taskStatus',
        'priority':'priority','client':'client',
        'project type':'projectTypes','projecttype':'projectTypes',
        'start date':'startDate','due date':'dueDate',
        'assigned to':'assignees','notes':'notes'
      };
      const imported=rows.slice(1).map((row,i)=>{
        const proj={id:uuid(),createdAt:new Date().toISOString(),createdBy:localStorage.getItem('d2s_session')||'import'};
        headers.forEach((h,idx)=>{
          const key=colMap[h];if(!key)return;
          const v=String(row[idx]||'').trim();
          if(key==='projectTypes'||key==='assignees')proj[key]=v?v.split(',').map(s=>s.trim()).filter(Boolean):[];
          else proj[key]=v;
        });
        return proj;
      }).filter(p=>p.name);
      const existing=getProjects();
      saveAllProjects([...existing,...imported]);
      renderProjects();
      toast(`Imported ${imported.length} project${imported.length!==1?'s':''}!`,'success');
    }catch(err){toast('Failed to parse Excel: '+err.message,'error');}
  };
  r.readAsArrayBuffer(file);
  e.target.value='';
}

// ═══════════════════════════════════════════════════════
//  INVITE
// ═══════════════════════════════════════════════════════
function copyUrl(){
  const url=location.href.split('#')[0];
  navigator.clipboard.writeText(url).then(()=>toast('Link copied!','success')).catch(()=>toast('Copy manually: '+url));
}

function buildAllowedUsersList(){
  document.getElementById('allowed-users-list').innerHTML=ALLOWED.map(em=>{
    const has=!!localStorage.getItem('d2s_pw_'+em);
    const nm=em.split('@')[0].replace(/\./g,' ').replace(/\b\w/g,c=>c.toUpperCase());
    return`<div class="user-pill">
      <div class="av">${initials(nm)}</div>
      <div class="info"><div class="nm">${nm}</div><div class="em">${em}</div></div>
      <span class="badge ${has?'badge-completed':'badge-on-hold'}" style="margin-left:auto">${has?'Active':'No password'}</span>
    </div>`;
  }).join('');
}

// ═══════════════════════════════════════════════════════
//  CHANGE PASSWORD
// ═══════════════════════════════════════════════════════
function openChangePw(){
  ['cpw-current','cpw-new','cpw-confirm'].forEach(id=>document.getElementById(id).value='');
  hideErr('cpw-err');
  openModal('change-pw-modal');
}
async function changePassword(){
  const email=localStorage.getItem('d2s_session')||'';
  const curr=document.getElementById('cpw-current').value;
  const nw=document.getElementById('cpw-new').value;
  const conf=document.getElementById('cpw-confirm').value;
  hideErr('cpw-err');
  if((await sha256(curr))!==localStorage.getItem('d2s_pw_'+email)){showErr('cpw-err','Current password is incorrect.');return}
  if(nw.length<8){showErr('cpw-err','New password must be at least 8 characters.');return}
  if(nw!==conf){showErr('cpw-err','Passwords do not match.');return}
  localStorage.setItem('d2s_pw_'+email,await sha256(nw));
  closeModal('change-pw-modal');
  toast('Password updated!','success');
}

// ═══════════════════════════════════════════════════════
//  SETTINGS TOKEN
// ═══════════════════════════════════════════════════════
// (already defined above)

// ═══════════════════════════════════════════════════════
//  INIT
// ═══════════════════════════════════════════════════════
(function init(){
  // Check for public report share link first (no auth required)
  const params=new URLSearchParams(window.location.search);
  if(params.get('report')){
    checkPublicReportUrl();
    return; // Don't show the login screen; public view handles everything
  }
  const s=localStorage.getItem('d2s_session');
  if(s&&ALLOWED.includes(s))enterApp(s);
  else showScreen('screen-login');
  // Sticky offsets are measured in navTo('projects') when the page is visible
})();
</script>
</body>
</html>
